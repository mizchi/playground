unsafe extern "C" {
    #[link_name = "unlink"]
    fn __exr_unlink(path: *const u8) -> i32;
}

// stat の st_mode (S_IFMT の部分)。失敗なら 0
fn __exr_path_mode<G>(p: &str) -> u32 {
    let c = __exr_c_path::<()>(p.as_bytes());
    let mut buf = [0u64; 32];
    let r = unsafe { __exr_stat(c.as_ptr(), buf.as_mut_ptr() as *mut u8) };
    if r != 0 {
        return 0;
    }
    // (x86_64 の struct stat: st_mode は 24 byte 目からの u32)
    (buf[3] as u32) & 0o170000
}

// Path (= str) のメソッド
pub trait __PathExt {
    fn display(&self) -> &str;
    fn is_absolute(&self) -> bool;
    fn is_relative(&self) -> bool;
    fn join(&self, p: &str) -> PathBuf;
    fn file_name(&self) -> Option<&str>;
    fn file_stem(&self) -> Option<&str>;
    fn extension(&self) -> Option<&str>;
    fn parent(&self) -> Option<&str>;
    fn with_extension(&self, e: &str) -> PathBuf;
    fn to_string_lossy(&self) -> String;
    fn to_str(&self) -> Option<&str>;
    fn as_os_str(&self) -> &str;
    fn to_path_buf(&self) -> PathBuf;
    fn exists(&self) -> bool;
    fn is_file(&self) -> bool;
    fn is_dir(&self) -> bool;
}

impl __PathExt for str {
    fn display(&self) -> &str {
        self
    }
    fn is_absolute(&self) -> bool {
        self.starts_with('/')
    }
    fn is_relative(&self) -> bool {
        !self.starts_with('/')
    }
    fn join(&self, p: &str) -> PathBuf {
        let mut b = PathBuf { s: String::from(self) };
        b.push(p);
        b
    }
    fn file_name(&self) -> Option<&str> {
        let t = self.trim_end_matches('/');
        let n = match t.rfind('/') {
            Some(i) => &t[i + 1..],
            None => t,
        };
        if n.is_empty() || n == ".." || (n == "." && t.len() == self.len()) {
            None
        } else {
            Some(n)
        }
    }
    fn file_stem(&self) -> Option<&str> {
        let n = self.file_name()?;
        if n == ".." {
            return Some(n);
        }
        match n.rfind('.') {
            Some(0) | None => Some(n),
            Some(i) => Some(&n[..i]),
        }
    }
    fn extension(&self) -> Option<&str> {
        let n = self.file_name()?;
        match n.rfind('.') {
            Some(0) | None => None,
            Some(i) => Some(&n[i + 1..]),
        }
    }
    fn parent(&self) -> Option<&str> {
        let t = self.trim_end_matches('/');
        if t.is_empty() {
            return None;
        }
        match t.rfind('/') {
            Some(0) => Some("/"),
            Some(i) => Some(t[..i].trim_end_matches('/')),
            None => Some(""),
        }
    }
    fn with_extension(&self, e: &str) -> PathBuf {
        let mut b = PathBuf { s: String::from(self) };
        b.set_extension(e);
        b
    }
    fn to_string_lossy(&self) -> String {
        String::from(self)
    }
    fn to_str(&self) -> Option<&str> {
        Some(self)
    }
    fn as_os_str(&self) -> &str {
        self
    }
    fn to_path_buf(&self) -> PathBuf {
        PathBuf { s: String::from(self) }
    }
    fn exists(&self) -> bool {
        __exr_path_mode::<()>(self) != 0
    }
    fn is_file(&self) -> bool {
        __exr_path_mode::<()>(self) == 0o100000
    }
    fn is_dir(&self) -> bool {
        __exr_path_mode::<()>(self) == 0o040000
    }
}

impl PathBuf {
    pub fn new() -> PathBuf {
        PathBuf { s: String::new() }
    }
    // (std と同じく、絶対パスを足すと置き換え)
    pub fn push(&mut self, p: &str) {
        if p.starts_with('/') {
            self.s = String::from(p);
            return;
        }
        if !self.s.is_empty() && !self.s.ends_with('/') {
            self.s.push('/');
        }
        self.s.push_str(p);
    }
    pub fn pop(&mut self) -> bool {
        match __PathExt::parent(self.s.as_str()) {
            Some(q) => {
                let n = q.len();
                self.s.truncate(n);
                true
            }
            None => false,
        }
    }
    pub fn set_extension(&mut self, e: &str) -> bool {
        let Some(stem) = __PathExt::file_stem(self.s.as_str()) else { return false };
        let end = stem.as_ptr() as usize - self.s.as_str().as_ptr() as usize + stem.len();
        self.s.truncate(end);
        if !e.is_empty() {
            self.s.push('.');
            self.s.push_str(e);
        }
        true
    }
    pub fn as_path(&self) -> &str {
        self.s.as_str()
    }
    pub fn into_os_string(self) -> String {
        self.s
    }
}

impl Deref for PathBuf {
    type Target = str;
    fn deref(&self) -> &str {
        self.s.as_str()
    }
}

impl From<&str> for PathBuf {
    fn from(s: &str) -> PathBuf {
        PathBuf { s: String::from(s) }
    }
}

impl From<String> for PathBuf {
    fn from(s: String) -> PathBuf {
        PathBuf { s: s }
    }
}

impl Debug for PathBuf {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        write!(f, "{:?}", self.s.as_str())
    }
}

// パスとして受け取れる型 (&str / String / PathBuf)
pub trait __AsPathStr {
    fn __as_path_str(&self) -> &str;
}
impl __AsPathStr for str {
    fn __as_path_str(&self) -> &str {
        self
    }
}
impl __AsPathStr for String {
    fn __as_path_str(&self) -> &str {
        self.as_str()
    }
}
impl __AsPathStr for PathBuf {
    fn __as_path_str(&self) -> &str {
        self.s.as_str()
    }
}
impl __AsBytes for PathBuf {
    fn __as_bytes(&self) -> &[u8] {
        self.s.as_bytes()
    }
}

// `Path::new(s)`: 同じ文字列
pub fn __exr_path_new<P: __AsPathStr>(p: &P) -> &str {
    p.__as_path_str()
}

pub fn __exr_fs_remove_file<P>(path: P) -> Result<(), IoError> {
    let c = __exr_c_path::<()>(path.__as_bytes());
    if unsafe { __exr_unlink(c.as_ptr()) } != 0 {
        return Err(IoError::last_os_error());
    }
    Ok(())
}

pub fn __exr_env_var_os<K>(key: K) -> Option<String> {
    let c = __exr_c_path::<()>(key.__as_bytes());
    let p = unsafe { __exr_getenv(c.as_ptr()) };
    if p.is_null() {
        return None;
    }
    Some(String::from(__exr_cstr::<()>(p)))
}

// `env::split_paths(&path)`: `:` で区切った PathBuf の列
pub fn __exr_env_split_paths<P: __AsPathStr>(p: &P) -> IntoIter<PathBuf> {
    let mut v: Vec<PathBuf> = Vec::new();
    for d in p.__as_path_str().split(':') {
        v.push(PathBuf { s: String::from(d) });
    }
    v.into_iter()
}

