// パスや中身として渡せる型 (&str / String / &[u8] / Vec<u8>)
pub trait __AsBytes {
    fn __as_bytes(&self) -> &[u8];
}
impl __AsBytes for str {
    fn __as_bytes(&self) -> &[u8] {
        self.as_bytes()
    }
}
impl __AsBytes for String {
    fn __as_bytes(&self) -> &[u8] {
        self.as_bytes()
    }
}
impl __AsBytes for [u8] {
    fn __as_bytes(&self) -> &[u8] {
        self
    }
}
impl __AsBytes for Vec<u8> {
    fn __as_bytes(&self) -> &[u8] {
        self.as_slice()
    }
}

// NUL で終わるコピー
fn __exr_c_path<G>(p: &[u8]) -> Vec<u8> {
    let mut v: Vec<u8> = Vec::with_capacity(p.len() + 1);
    v.extend_from_slice(p);
    v.push(0);
    v
}

fn __exr_read_fd_all<G>(fd: i32) -> Result<Vec<u8>, IoError> {
    let mut v: Vec<u8> = Vec::with_capacity(4096);
    loop {
        if v.cap - v.len < 4096 {
            v.reserve(4096);
        }
        let n = unsafe { __exr_read(fd, v.ptr.add(v.len), v.cap - v.len) };
        if n < 0 {
            let e = IoError::last_os_error();
            if e.code == 4 {
                continue;
            }
            return Err(e);
        }
        if n == 0 {
            return Ok(v);
        }
        v.len += n as usize;
    }
}

pub fn __exr_fs_read<P>(path: P) -> Result<Vec<u8>, IoError> {
    let c = __exr_c_path::<()>(path.__as_bytes());
    let fd = unsafe { __exr_open(c.as_ptr(), 0, 0) };
    if fd < 0 {
        return Err(IoError::last_os_error());
    }
    let r = __exr_read_fd_all::<()>(fd);
    unsafe {
        __exr_close(fd);
    }
    r
}

pub fn __exr_fs_read_to_string<P>(path: P) -> Result<String, IoError> {
    let v = __exr_fs_read(path)?;
    match String::from_utf8(v) {
        Ok(s) => Ok(s),
        Err(_) => Err(IoError { code: -1 }),
    }
}

pub fn __exr_fs_write<P, C>(path: P, contents: C) -> Result<(), IoError> {
    let c = __exr_c_path::<()>(path.__as_bytes());
    // O_WRONLY | O_CREAT | O_TRUNC, 0o666
    let fd = unsafe { __exr_open(c.as_ptr(), 0x241, 0o666) };
    if fd < 0 {
        return Err(IoError::last_os_error());
    }
    let b = contents.__as_bytes();
    let mut off = 0;
    while off < b.len() {
        let n = unsafe { __exr_write(fd, b.as_ptr().add(off), b.len() - off) };
        if n < 0 {
            let e = IoError::last_os_error();
            unsafe {
                __exr_close(fd);
            }
            return Err(e);
        }
        off += n as usize;
    }
    unsafe {
        __exr_close(fd);
    }
    Ok(())
}

// std::env::args: /proc/self/cmdline (NUL 区切り) から
pub struct Args {
    v: Vec<String>,
    i: usize,
}

impl Iterator for Args {
    type Item = String;
    fn next(&mut self) -> Option<String> {
        if self.i < self.v.len() {
            self.i += 1;
            Some(self.v[self.i - 1].clone())
        } else {
            None
        }
    }
}

impl Args {
    pub fn len(&self) -> usize {
        self.v.len() - self.i
    }
}

pub fn __exr_env_args() -> Args {
    let mut v: Vec<String> = Vec::new();
    if let Ok(b) = __exr_fs_read("/proc/self/cmdline") {
        let mut st = 0;
        let mut i = 0;
        while i < b.len() {
            if b[i] == 0 {
                v.push(String::from_utf8_lossy(&b[st..i]));
                st = i + 1;
            }
            i += 1;
        }
    }
    Args { v: v, i: 0 }
}

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum VarError {
    NotPresent,
    NotUnicode,
}

impl Display for VarError {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        __exr_fmt_str::<()>(f, if *self == VarError::NotPresent { "environment variable not found" } else { "environment variable was not valid unicode" });
        Ok(())
    }
}

pub fn __exr_env_var<K>(key: K) -> Result<String, VarError> {
    let c = __exr_c_path::<()>(key.__as_bytes());
    let p = unsafe { __exr_getenv(c.as_ptr()) };
    if p.is_null() {
        return Err(VarError::NotPresent);
    }
    Ok(String::from(__exr_cstr::<()>(p)))
}

// --- std::borrow::Cow (スライスの Cow<[T]> は Cow<T>、Cow<str> は __CowStr) ---

pub enum Cow<T> {
    Borrowed(&[T]),
    Owned(Vec<T>),
}

impl<T: Clone> Cow<T> {
    pub fn into_owned(self) -> Vec<T> {
        match self {
            Cow::Borrowed(s) => s.to_vec(),
            Cow::Owned(v) => v,
        }
    }
    pub fn is_borrowed(&self) -> bool {
        match self {
            Cow::Borrowed(_) => true,
            Cow::Owned(_) => false,
        }
    }
    pub fn is_owned(&self) -> bool {
        !self.is_borrowed()
    }
}

impl<T> Deref for Cow<T> {
    type Target = [T];
    fn deref(&self) -> &[T] {
        match self {
            Cow::Borrowed(s) => *s,
            Cow::Owned(v) => v.as_slice(),
        }
    }
}

pub enum __CowStr {
    Borrowed(&str),
    Owned(String),
}

impl __CowStr {
    pub fn into_owned(self) -> String {
        match self {
            __CowStr::Borrowed(s) => String::from(s),
            __CowStr::Owned(v) => v,
        }
    }
}

impl Deref for __CowStr {
    type Target = str;
    fn deref(&self) -> &str {
        match self {
            __CowStr::Borrowed(s) => *s,
            __CowStr::Owned(v) => v.as_str(),
        }
    }
}

