unsafe extern "C" {
    #[link_name = "fork"]
    fn __exr_fork() -> i32;
}
unsafe extern "C" {
    #[link_name = "execvp"]
    fn __exr_execvp(file: *const u8, argv: *const *const u8) -> i32;
}
unsafe extern "C" {
    #[link_name = "pipe2"]
    fn __exr_pipe2(fds: *mut i32, flags: i32) -> i32;
}
unsafe extern "C" {
    #[link_name = "dup2"]
    fn __exr_dup2(a: i32, b: i32) -> i32;
}
unsafe extern "C" {
    #[link_name = "_exit"]
    fn __exr_exit_now(code: i32);
}
unsafe extern "C" {
    #[link_name = "waitpid"]
    fn __exr_waitpid(pid: i32, status: *mut i32, opts: i32) -> i32;
