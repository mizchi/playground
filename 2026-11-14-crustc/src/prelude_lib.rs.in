    fn from_str_radix(s: &str, radix: u32) -> Result<i64, ParseIntError> {
        match __exr_parse_radix::<()>(s, radix, true, 9223372036854775807, 9223372036854775808) {
            Ok((n, v)) => Ok(if n { (v as i64).wrapping_neg() } else { v as i64 }),
