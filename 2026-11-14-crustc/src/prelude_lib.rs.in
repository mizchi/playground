// std::io::Error: OS のエラー (errno) か、種類とメッセージ (code < 0: InvalidData など)
#[derive(Clone, Copy, PartialEq, Eq)]
pub struct IoError {
    code: i32,
}

unsafe extern "C" {
    #[link_name = "strerror"]
    fn __exr_strerror(e: i32) -> *const u8;
}

unsafe extern "C" {
    #[link_name = "strlen"]
    fn __exr_strlen(p: *const u8) -> usize;
}

unsafe extern "C" {
    #[link_name = "__errno_location"]
    fn __exr_errno_location() -> *mut i32;
}

fn __exr_cstr<G>(p: *const u8) -> &str {
    unsafe { core::str::from_utf8_unchecked(core::slice::from_raw_parts(p, __exr_strlen(p))) }
}

// (std の ErrorKind の名前: errno から)
fn __exr_io_kind<G>(code: i32) -> &str {
    if code == -1 {
        "InvalidData"
    } else if code == 2 {
        "NotFound"
    } else if code == 13 || code == 1 {
        "PermissionDenied"
    } else if code == 17 {
        "AlreadyExists"
    } else if code == 21 {
        "IsADirectory"
    } else if code == 20 {
        "NotADirectory"
    } else if code == 22 {
        "InvalidInput"
    } else if code == 32 {
        "BrokenPipe"
    } else if code == 4 {
        "Interrupted"
    } else {
        "Uncategorized"
    }
}

impl IoError {
    pub fn last_os_error() -> IoError {
        IoError { code: unsafe { *__exr_errno_location() } }
    }
    pub fn raw_os_error(&self) -> Option<i32> {
        if self.code > 0 { Some(self.code) } else { None }
    }
    fn __message(&self) -> &str {
        if self.code == -1 {
            "stream did not contain valid UTF-8"
        } else {
            __exr_cstr::<()>(unsafe { __exr_strerror(self.code) })
        }
    }
}

impl Display for IoError {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        __exr_fmt_str::<()>(f, self.__message());
        if self.code > 0 {
            __exr_fmt_str::<()>(f, " (os error ");
            __exr_fmt_int::<()>(f, self.code as u64, false);
            __exr_fmt_str::<()>(f, ")");
        }
        Ok(())
    }
}

impl Debug for IoError {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        if self.code > 0 {
            __exr_fmt_str::<()>(f, "Os { code: ");
            __exr_fmt_int::<()>(f, self.code as u64, false);
            __exr_fmt_str::<()>(f, ", kind: ");
            __exr_fmt_str::<()>(f, __exr_io_kind::<()>(self.code));
            __exr_fmt_str::<()>(f, ", message: ");
            __exr_fmt_str_debug::<()>(f, self.__message());
            __exr_fmt_str::<()>(f, " }");
        } else {
            __exr_fmt_str::<()>(f, "Error { kind: ");
            __exr_fmt_str::<()>(f, __exr_io_kind::<()>(self.code));
            __exr_fmt_str::<()>(f, ", message: ");
            __exr_fmt_str_debug::<()>(f, self.__message());
            __exr_fmt_str::<()>(f, " }");
        }
        Ok(())
    }
}

