pub struct Command {
    prog: String,
    args: Vec<String>,
}

#[derive(Clone, Copy, PartialEq, Eq)]
pub struct __ExitStatus {
    raw: i32,
}

pub struct __ProcOutput {
    pub status: __ExitStatus,
    pub stdout: Vec<u8>,
    pub stderr: Vec<u8>,
}

impl __ExitStatus {
    pub fn success(&self) -> bool {
        self.raw == 0
    }
    pub fn code(&self) -> Option<i32> {
        if self.raw & 0x7f == 0 { Some((self.raw >> 8) & 0xff) } else { None }
    }
}

impl Display for __ExitStatus {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        match self.code() {
            Some(c) => write!(f, "exit status: {}", c),
            None => write!(f, "signal: {}", self.raw & 0x7f),
        }
    }
}

impl Debug for __ExitStatus {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        match self.code() {
            Some(c) => write!(f, "ExitStatus(unix_wait_status({}))", c << 8),
            None => write!(f, "ExitStatus(unix_wait_status({}))", self.raw),
        }
    }
}

impl Command {
    pub fn new<S: __AsPathStr>(prog: &S) -> Command {
        Command { prog: String::from(prog.__as_path_str()), args: Vec::new() }
    }
    pub fn arg<S: __AsPathStr>(&mut self, a: &S) -> &mut Command {
        self.args.push(String::from(a.__as_path_str()));
        self
    }
    pub fn args<I>(&mut self, it: I) -> &mut Command {
        for a in it {
            self.args.push(String::from(a.__as_path_str()));
        }
        self
    }
    pub fn get_program(&self) -> &str {
        self.prog.as_str()
    }
    // 子を起動する。capture なら stdout / stderr を pipe にして (fd の組を返す)
    fn __spawn(&self, capture: bool) -> Result<(i32, i32, i32), IoError> {
        let mut cs: Vec<Vec<u8>> = Vec::new();
        cs.push(__exr_c_path::<()>(self.prog.as_bytes()));
        for a in self.args.iter() {
            cs.push(__exr_c_path::<()>(a.as_bytes()));
        }
        let mut argv: Vec<*const u8> = Vec::new();
        for c in cs.iter() {
            argv.push(c.as_ptr());
        }
        argv.push(core::ptr::null());
        let mut out = [0i32; 2];
        let mut err = [0i32; 2];
        let mut ex = [0i32; 2];
        // (exec の失敗は close-on-exec の pipe で親に errno を送る)
        unsafe {
            if capture && (__exr_pipe2(out.as_mut_ptr(), 0x80000) != 0 || __exr_pipe2(err.as_mut_ptr(), 0x80000) != 0) {
                return Err(IoError::last_os_error());
            }
            if __exr_pipe2(ex.as_mut_ptr(), 0x80000) != 0 {
                return Err(IoError::last_os_error());
            }
            let pid = __exr_fork();
            if pid < 0 {
                return Err(IoError::last_os_error());
            }
            if pid == 0 {
                if capture {
                    __exr_dup2(out[1], 1);
                    __exr_dup2(err[1], 2);
                }
                __exr_execvp(argv[0], argv.as_ptr());
                let e = *__exr_errno_location();
                __exr_write(ex[1], &e as *const i32 as *const u8, 4);
                __exr_exit_now(127);
            }
            __exr_close(ex[1]);
            if capture {
                __exr_close(out[1]);
                __exr_close(err[1]);
            }
            let mut e = 0i32;
            let n = __exr_read(ex[0], &mut e as *mut i32 as *mut u8, 4);
            __exr_close(ex[0]);
            if n == 4 {
                let mut st = 0i32;
                __exr_waitpid(pid, &mut st as *mut i32, 0);
                if capture {
                    __exr_close(out[0]);
                    __exr_close(err[0]);
                }
                return Err(IoError { code: e });
            }
            Ok((pid, out[0], err[0]))
        }
    }
    pub fn status(&mut self) -> Result<__ExitStatus, IoError> {
        let (pid, _, _) = self.__spawn(false)?;
        let mut st = 0i32;
        unsafe {
            __exr_waitpid(pid, &mut st as *mut i32, 0);
        }
        Ok(__ExitStatus { raw: st })
    }
    pub fn output(&mut self) -> Result<__ProcOutput, IoError> {
        let (pid, o, e) = self.__spawn(true)?;
        let mut so: Vec<u8> = Vec::new();
        let mut se: Vec<u8> = Vec::new();
        // (両方を poll で読む: 片方が詰まっても止まらない)
        let mut open = [true, true];
        let mut buf = [0u8; 4096];
        while open[0] || open[1] {
            let mut fds = [o, if open[0] { 1 } else { 0 }, e, if open[1] { 1 } else { 0 }];
            if !open[0] {
                fds[0] = -1;
            }
            if !open[1] {
                fds[2] = -1;
            }
            unsafe {
                __exr_poll(fds.as_mut_ptr(), 2, -1);
            }
            for k in 0..2 {
                if !open[k] || (fds[k * 2 + 1] >> 16) == 0 {
                    continue;
                }
                let fd = if k == 0 { o } else { e };
                let n = unsafe { __exr_read(fd, buf.as_mut_ptr(), 4096) };
                if n <= 0 {
                    open[k] = false;
                    unsafe {
                        __exr_close(fd);
                    }
                } else if k == 0 {
                    so.extend_from_slice(&buf[..n as usize]);
                } else {
                    se.extend_from_slice(&buf[..n as usize]);
                }
            }
        }
        let mut st = 0i32;
        unsafe {
            __exr_waitpid(pid, &mut st as *mut i32, 0);
        }
        Ok(__ProcOutput { status: __ExitStatus { raw: st }, stdout: so, stderr: se })
    }
}

// 1 行 (改行まで。改行も入れる) を buf の後ろに足す。読んだバイト数 (0 なら終わり)
fn __exr_read_line<G>(buf: &mut String) -> usize {
    let mut n = 0;
    loop {
        let c = unsafe { __exr_getchar() };
        if c < 0 {
            break;
        }
        buf.vec.push(c as u8);
        n += 1;
        if c == 10 {
            break;
        }
    }
    n
}

pub struct Stdin {
    _x: u8,
}

pub struct StdinLock {
    _x: u8,
}

pub fn __core_stdin() -> Stdin {
    Stdin { _x: 0 }
}

impl Stdin {
    pub fn read_line(&self, buf: &mut String) -> Result<usize, IoError> {
        Ok(__exr_read_line::<()>(buf))
    }
    pub fn read_to_string(&mut self, buf: &mut String) -> Result<usize, IoError> {
        let mut n = 0;
        loop {
            let k = __exr_read_line::<()>(buf);
            if k == 0 {
                break;
            }
            n += k;
        }
        Ok(n)
    }
    pub fn lock(&self) -> StdinLock {
        StdinLock { _x: 0 }
    }
    pub fn lines(self) -> StdinLines {
        StdinLines { _x: 0 }
    }
}

impl StdinLock {
    pub fn read_line(&mut self, buf: &mut String) -> Result<usize, IoError> {
        Ok(__exr_read_line::<()>(buf))
    }
    pub fn lines(self) -> StdinLines {
        StdinLines { _x: 0 }
    }
}

pub struct StdinLines {
    _x: u8,
}

impl Iterator for StdinLines {
    type Item = Result<String, IoError>;
    fn next(&mut self) -> Option<Result<String, IoError>> {
        let mut s = String::new();
        if __exr_read_line::<()>(&mut s) == 0 {
            return None;
        }
        // 末尾の \n / \r\n は落とす
        if s.vec.len > 0 && s.vec[s.vec.len - 1] == 10 {
            s.vec.pop();
            if s.vec.len > 0 && s.vec[s.vec.len - 1] == 13 {
                s.vec.pop();
            }
        }
        Some(Ok(s))
    }
}

pub struct Stdout {
    _x: u8,
}

pub struct StdoutLock {
    _x: u8,
}

pub fn __core_stdout() -> Stdout {
    Stdout { _x: 0 }
}

fn __exr_out_str<G>(s: &str) {
    for &b in s.as_bytes() {
        unsafe {
            __exr_putchar(b as i32);
        }
    }
}

impl Stdout {
    pub fn lock(&self) -> StdoutLock {
        StdoutLock { _x: 0 }
    }
    pub fn write_str(&mut self, s: &str) -> Result<(), IoError> {
        __exr_out_str::<()>(s);
        Ok(())
    }
    pub fn flush(&mut self) -> Result<(), IoError> {
        unsafe {
            __exr_fflush(core::ptr::null_mut());
        }
        Ok(())
    }
}

impl StdoutLock {
    pub fn write_str(&mut self, s: &str) -> Result<(), IoError> {
        __exr_out_str::<()>(s);
        Ok(())
    }
    pub fn flush(&mut self) -> Result<(), IoError> {
        unsafe {
            __exr_fflush(core::ptr::null_mut());
        }
        Ok(())
    }
}

// `BufWriter::new(stdout.lock())`: 書き込みはそのまま中身へ (stdio がバッファする)
pub struct BufWriter<W> {
    w: W,
}

impl<W> BufWriter<W> {
    pub fn new(w: W) -> BufWriter<W> {
        BufWriter { w: w }
    }
    pub fn write_str(&mut self, s: &str) -> Result<(), IoError> {
        self.w.write_str(s)
    }
    pub fn flush(&mut self) -> Result<(), IoError> {
        self.w.flush()
    }
}

unsafe extern "C" {
    #[link_name = "exit"]
    fn __exr_exit(code: i32);
}

fn __exr_err_str<G>(s: &str) {
    unsafe {
        __exr_write(2, s.as_ptr(), s.len());
    }
}


unsafe extern "C" {
    #[link_name = "sigaction"]
    fn __exr_sigaction(sig: i32, act: *const u64, old: *mut u64) -> i32;
}

// `unwrap` / `expect` を呼んだ場所 (行 << 16 | 列)。その中の panic はこの場所を出す (#[track_caller] 相当)
static mut __EXR_CALLER: u64 = 0;

// panic の trap の表 (中身はリンクの前に driver が入れる。形は emit_object を参照)
static __EXR_TRAP_TABLE: [u64; 3] = [0, 0, 0];
static mut __EXR_SA: [u64; 19] = [0; 19];
static __EXR_KIND_MSG: &str = "attempt to add with overflowattempt to subtract with overflowattempt to multiply with overflowattempt to divide by zeroattempt to calculate the remainder with a divisor of zeroexplicit panicattempt to negate with overflowattempt to shift left with overflowattempt to shift right with overflowattempt to divide with overflowattempt to calculate the remainder with overflowexplicit panic";
static __EXR_KIND_OFF: [u16; 13] = [0, 28, 61, 94, 119, 176, 190, 221, 256, 292, 323, 371, 385];

fn __exr_err_num<G>(n: u64) {
    let mut d = [0u8; 20];
    let p = d.as_mut_ptr();
    let mut k = 20;
    let mut v = n;
    loop {
        k -= 1;
        unsafe {
            *p.add(k) = b'0' + (v % 10) as u8;
        }
        v /= 10;
        if v == 0 {
            break;
        }
    }
    unsafe {
        __exr_write(2, p.add(k) as *const u8, 20 - k);
    }
}

// 表のファイルの対応 (表の 16 byte の後ろ): 区間の数, (結合したソースでの開始行, ファイルでの開始行, 名前の長さ, 名前) *,
// 桁のずれの数, (行, 桁, ずれ (zigzag)) *
// 結合したソースの (行, 桁) → (ファイルの名前のポインタ, 長さ, ファイルの中の行, 桁)。区間がなければ src/main.rs
fn __exr_tab_file(t: *const u64, line: u64, col: u64) -> (*const u8, usize, u64, u64) {
    let mut p = unsafe { (t as *const u8).add(16) };
    let n = __exr_tab_uv(&mut p);
    let mut best: (*const u8, usize, u64) = ("src/main.rs".as_ptr(), 11, line);
    let mut k = 0;
    while k < n {
        let start = __exr_tab_uv(&mut p);
        let first = __exr_tab_uv(&mut p);
        let len = __exr_tab_uv(&mut p) as usize;
        if start <= line {
            best = (p, len, line - start + first);
        }
        p = unsafe { p.add(len) };
        k += 1;
    }
    let nf = __exr_tab_uv(&mut p);
    let mut d: u64 = 0;
    let mut k = 0;
    while k < nf {
        let l = __exr_tab_uv(&mut p);
        let c = __exr_tab_uv(&mut p);
        let z = __exr_tab_uv(&mut p);
        if l == line && c <= col {
            d = if z & 1 == 0 { z >> 1 } else { (!(z >> 1)).wrapping_add(0) };
        }
        k += 1;
    }
    (best.0, best.1, best.2, col.wrapping_sub(d))
}

fn __exr_panic_head<G>(line: u64, col: u64) {
    // (行 0: 呼んだ側の場所)
    let (line, col) = if line == 0 {
        let c = unsafe { __EXR_CALLER };
        (c >> 16, c & 0xFFFF)
    } else {
        (line, col)
    };
    let (f, n, l, c) = __exr_tab_file(__EXR_TRAP_TABLE.as_ptr(), line, col);
    __exr_panic_head_at::<()>(f, n, l, c);
}

fn __exr_panic_head_at<G>(f: *const u8, n: usize, line: u64, col: u64) {
    unsafe {
        __exr_fflush(core::ptr::null_mut());
    }
    __exr_err_str::<()>("\nthread 'main' panicked at ");
    unsafe {
        __exr_write(2, f, n);
    }
    __exr_err_str::<()>(":");
    __exr_err_num::<()>(line);
    __exr_err_str::<()>(":");
    __exr_err_num::<()>(col);
    __exr_err_str::<()>(":\n");
}

fn __exr_panic_tail<G>() {
    __exr_err_str::<()>("\nnote: run with `RUST_BACKTRACE=1` environment variable to display a backtrace\n");
    unsafe {
        __exr_exit(101);
    }
}

// trap (ud2 の SIGILL) で止まったら、発生したアドレスで表を引いて panic のメッセージを出し、101 で終わる
// 表の可変長整数 (7 bit ずつ) を 1 つ読む
fn __exr_tab_uv(p: &mut *const u8) -> u64 {
    let mut v = 0u64;
    let mut sh = 0;
    loop {
        let b = unsafe { **p };
        *p = unsafe { (*p).add(1) };
        v |= ((b & 0x7F) as u64) << sh;
        if b < 0x80 {
            return v;
        }
        sh += 7;
    }
}

// trap (ud2 の SIGILL) で止まったら、発生したアドレスで表を引いて panic のメッセージを出し、101 で終わる。
// 表 (driver が作る): [.text の先頭のアドレス (8 byte)] の後ろに可変長整数の列
//   メッセージの数, (長さ, 中身) *, 関数の数, (前の関数からのオフセットの差, 場所の数,
//   (前の場所からのオフセットの差, 種類 | (メッセージ番号 + 1) << 4, 行の差 (zigzag), 列) *) *
// 表 t で pc を探す: (見つかったか, 種類, メッセージ番号, 行, 列, メッセージの列の先頭)
fn __exr_trap_search(t: *const u64, pc: u64) -> (bool, u64, u64, u64, u64, *const u8) {
    let base = unsafe { *t };
    let mut p = unsafe { (t as *const u8).add(16) };
    let ns = __exr_tab_uv(&mut p);
    let mut k = 0;
    while k < ns {
        let _ = __exr_tab_uv(&mut p);
        let _ = __exr_tab_uv(&mut p);
        let n = __exr_tab_uv(&mut p);
        p = unsafe { p.add(n as usize) };
        k += 1;
    }
    let nfix = __exr_tab_uv(&mut p);
    let mut k = 0;
    while k < 3 * nfix {
        let _ = __exr_tab_uv(&mut p);
        k += 1;
    }
    let m0 = p;
    let nm = __exr_tab_uv(&mut p);
    let mut k = 0;
    while k < nm {
        let n = __exr_tab_uv(&mut p);
        p = unsafe { p.add(n as usize) };
        k += 1;
    }
    let nf = __exr_tab_uv(&mut p);
    let mut fa = base;
    let mut cur_line: u64 = 0;
    let mut i = 0;
    while i < nf {
        fa = fa.wrapping_add(__exr_tab_uv(&mut p));
        let n = __exr_tab_uv(&mut p);
        let mut at = fa;
        let mut j = 0;
        while j < n {
            at = at.wrapping_add(__exr_tab_uv(&mut p));
            let km = __exr_tab_uv(&mut p);
            let z = __exr_tab_uv(&mut p);
            cur_line = cur_line.wrapping_add(if z & 1 == 0 { z >> 1 } else { (!(z >> 1)).wrapping_add(0) });
            let c = __exr_tab_uv(&mut p);
            if at == pc {
                return (true, km & 0xF, km >> 4, cur_line, c, m0);
            }
            j += 1;
        }
        i += 1;
    }
    (false, 0, 0, 0, 0, m0)
}

fn __exr_on_trap(sig: i32, info: *const u64, ctx: *const u8) {
    let _ = (sig, ctx);
    let pc = unsafe { *info.add(2) };
    // (表はクレートごとにある。実行ファイルの表の 8 byte 目は、ほかのクレートの表の列 [数, アドレス *] を指す)
    let mut ft = __EXR_TRAP_TABLE.as_ptr();
    let (mut found, mut kind, mut mi, mut line, mut col, mut msgs) = __exr_trap_search(ft, pc);
    let ext = unsafe { *ft.add(1) } as *const u64;
    if !found && !ext.is_null() {
        let n = unsafe { *ext };
        let mut k = 0;
        while k < n && !found {
            let t = unsafe { *ext.add(1 + k as usize) } as *const u64;
            let r = __exr_trap_search(t, pc);
            if r.0 {
                found = true;
                kind = r.1;
                mi = r.2;
                line = r.3;
                col = r.4;
                msgs = r.5;
                ft = t;
            }
            k += 1;
        }
    }
    if !found {
        unsafe {
            __exr_fflush(core::ptr::null_mut());
        }
        __exr_err_str::<()>("\nthread 'main' panicked");
        __exr_panic_tail::<()>();
    }
    // (行 0: 呼んだ側の場所 (unwrap など))
    let (line, col) = if line == 0 {
        let c = unsafe { __EXR_CALLER };
        (c >> 16, c & 0xFFFF)
    } else {
        (line, col)
    };
    let (f, n, l, c) = __exr_tab_file(ft, line, col);
    __exr_panic_head_at::<()>(f, n, l, c);
    if mi != 0 {
        // (mi 番目 (1 始まり) のメッセージ)
        let mut q = msgs;
        let _ = __exr_tab_uv(&mut q);
        let mut k = 1;
        loop {
            let n = __exr_tab_uv(&mut q) as usize;
            if k == mi {
                unsafe {
                    __exr_write(2, q, n);
                }
                break;
            }
            q = unsafe { q.add(n) };
            k += 1;
        }
    } else {
        // (種類ごとのメッセージ: 繋げた文字列と、各メッセージの始まりの位置の表)
        let kind = if kind > 11 { 11 } else { kind as usize };
        unsafe {
            let o = __EXR_KIND_OFF.as_ptr();
            let (a, b) = (*o.add(kind) as usize, *o.add(kind + 1) as usize);
            __exr_write(2, __EXR_KIND_MSG.as_ptr().add(a), b - a);
        }
    }
    __exr_panic_tail::<()>();
}

// 書式つきの panic! (`panic!("bad {}", x)`): 書式化した文字列で
fn __exr_panic_fmt<G>(pre: &str, s: &String, line: u32, col: u32) {
    __exr_panic_head::<()>(line as u64, col as u64);
    __exr_err_str::<()>(pre);
    __exr_err_str::<()>(s.as_str());
    __exr_panic_tail::<()>();
}

fn __exr_panic_index<G>(len: usize, i: usize, line: u32, col: u32) {
    __exr_panic_head::<()>(line as u64, col as u64);
    __exr_err_str::<()>("index out of bounds: the len is ");
    __exr_err_num::<()>(len as u64);
    __exr_err_str::<()>(" but the index is ");
    __exr_err_num::<()>(i as u64);
    __exr_panic_tail::<()>();
}

fn __exr_rt_init<G>() {
    // struct sigaction: ハンドラ, sa_mask (128 byte), sa_flags (SA_SIGINFO = 4), sa_restorer
    unsafe {
        let p = __EXR_SA.as_mut_ptr();
        *p = __exr_on_trap as usize as u64;
        *p.add(17) = 4;
        __exr_sigaction(4, p as *const u64, core::ptr::null_mut());
    }
}

// `std::process::exit(code)`: stdio を書き出してから終わる
pub fn __core_process_exit(code: i32) -> ! {
    unsafe {
        __exr_exit(code);
    }
    loop {}
}

fn __exr_eprint<G>(s: &String) {
    unsafe {
        __exr_write(2, s.vec.ptr as *const u8, s.vec.len);
    }
}

unsafe extern "C" {
    #[link_name = "putchar"]
    fn __exr_putchar(c: i32) -> i32;
}

unsafe extern "C" {
    #[link_name = "write"]
    fn __exr_write(fd: i32, p: *const u8, n: usize) -> isize;
}

fn __exr_display<T>(x: &T, f: &mut Formatter) {}
fn __exr_fmt_ok<G>() -> Result<(), __FmtError> {
    Ok(())
}
fn __exr_debug<T>(x: &T, f: &mut Formatter) {}

impl Display for String {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        __exr_fmt_str::<()>(f, self.as_str());
        Ok(())
    }
}

impl Debug for String {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        __exr_fmt_str_debug::<()>(f, self.as_str());
        Ok(())
    }
}

// --- Deref / Rc / RefCell / Cell ---

pub trait Deref {
    type Target;
    fn deref(&self) -> &Self::Target;
}

// (`impl DerefMut for W`: deref_mut は Deref の Target の可変参照)
pub trait DerefMut {
    fn deref_mut(&mut self) -> &mut Self::Target;
}

struct __RcBox<T> {
    strong: usize,
    weak: usize,
    val: T,
}

// 参照カウント (単一スレッド)。弱参照はまだない
// (ポインタは型を消して持つ: `Rc<RefCell<Node>>` を Node が持つとき、レイアウトが中身を辿らないように)
pub struct Rc<T> {
    p: *mut u8,
}

impl<T> Rc<T> {
    pub fn new(v: T) -> Rc<T> {
        let p = unsafe { __exr_malloc(core::mem::size_of::<__RcBox<T>>()) } as *mut __RcBox<T>;
        unsafe {
            p.write(__RcBox { strong: 1, weak: 0, val: v });
        }
        Rc { p: p as *mut u8 }
    }
    fn __bx(&self) -> *mut __RcBox<T> {
        self.p as *mut __RcBox<T>
    }
    pub fn clone(&self) -> Rc<T> {
        unsafe {
            (*self.__bx()).strong += 1;
        }
        Rc { p: self.p }
    }
    pub fn strong_count(this: &Rc<T>) -> usize {
        unsafe { (*this.__bx()).strong }
    }
    pub fn ptr_eq(a: &Rc<T>, b: &Rc<T>) -> bool {
        a.p == b.p
    }
    pub fn as_ref(&self) -> &T {
        unsafe { &(*self.__bx()).val }
    }
}

// (Deref の代わりに固有メソッド: codegen はメソッドが見つからないとき `deref` を探す)
impl<T> Rc<T> {
    pub fn deref(&self) -> &T {
        unsafe { &(*self.__bx()).val }
    }
}

impl<T> Drop for Rc<T> {
    fn drop(&mut self) {
        unsafe {
            let b = self.__bx();
            (*b).strong -= 1;
            if (*b).strong == 0 {
                __exr_drop_in_place(&mut (*b).val as *mut T);
                __exr_free(self.p);
            }
        }
    }
}

impl<T> Debug for Rc<T> {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        __exr_debug(self.as_ref(), f);
        Ok(())
    }
}

impl<T> Display for Rc<T> {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        __exr_display(self.as_ref(), f);
        Ok(())
    }
}

// 内部可変性。借用の検査はしない (borrow / borrow_mut は参照をそのまま返す)
pub struct RefCell<T> {
    val: T,
}

impl<T> RefCell<T> {
    pub fn new(v: T) -> RefCell<T> {
        RefCell { val: v }
    }
    pub fn borrow(&self) -> &T {
        &self.val
    }
    pub fn borrow_mut(&self) -> &mut T {
        unsafe { &mut *(&self.val as *const T as *mut T) }
    }
    pub fn into_inner(self) -> T {
        self.val
    }
    pub fn replace(&self, v: T) -> T {
        __core_replace(self.borrow_mut(), v)
    }
    pub fn get_mut(&mut self) -> &mut T {
        &mut self.val
    }
}

impl<T> Debug for RefCell<T> {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        __exr_dbg_begin::<()>(f, "RefCell", 0);
        __exr_dbg_item::<()>(f, 0, "value");
        __exr_debug(&self.val, f);
        __exr_dbg_item_end::<()>(f);
        __exr_dbg_end::<()>(f, 1, 0, false);
        Ok(())
    }
}

pub struct Cell<T> {
    val: T,
}

// `std::ptr::eq(a, b)`: 同じアドレスか
pub fn __exr_ptr_eq<T>(a: &T, b: &T) -> bool {
    a as *const T == b as *const T
}

// `std::sync::Mutex` (スレッドは 1 本なので、lock は中身を指すだけ)
pub struct Mutex<T> {
    val: T,
}

pub struct MutexGuard<T> {
    p: *mut T,
}

impl<T> Mutex<T> {
    pub const fn new(v: T) -> Mutex<T> {
        Mutex { val: v }
    }
    pub fn lock(&self) -> Result<MutexGuard<T>, ()> {
        Ok(MutexGuard { p: &self.val as *const T as *mut T })
    }
    pub fn into_inner(self) -> Result<T, ()> {
        Ok(self.val)
    }
    pub fn get_mut(&mut self) -> Result<&mut T, ()> {
        Ok(&mut self.val)
    }
}

impl<T> Deref for MutexGuard<T> {
    type Target = T;
    fn deref(&self) -> &T {
        unsafe { &*self.p }
    }
}

// `std::sync::OnceLock` (スレッドは 1 本なので、初期化済みかどうかと値だけ)
pub struct OnceLock<T> {
    val: Option<T>,
}

impl<T> OnceLock<T> {
    pub const fn new() -> OnceLock<T> {
        OnceLock { val: None }
    }
    pub fn get(&self) -> Option<&T> {
        self.val.as_ref()
    }
    pub fn get_or_init<F: FnOnce() -> T>(&self, f: F) -> &T {
        if self.val.is_none() {
            let v = f();
            let p = &self.val as *const Option<T> as *mut Option<T>;
            unsafe {
                p.write(Some(v));
            }
        }
        self.val.as_ref().unwrap()
    }
    pub fn set(&self, v: T) -> Result<(), T> {
        if self.val.is_some() {
            return Err(v);
        }
        let p = &self.val as *const Option<T> as *mut Option<T>;
        unsafe {
            p.write(Some(v));
        }
        Ok(())
    }
}

impl<T> Cell<T> {
    pub fn new(v: T) -> Cell<T> {
        Cell { val: v }
    }
    pub fn get(&self) -> T {
        unsafe { (&self.val as *const T).read() }
    }
    pub fn set(&self, v: T) {
        unsafe {
            let p = &self.val as *const T as *mut T;
            __exr_drop_in_place(p);
            p.write(v);
        }
    }
    pub fn replace(&self, v: T) -> T {
        let p = &self.val as *const T as *mut T;
        unsafe {
            let old = p.read();
            p.write(v);
            old
        }
    }
    pub fn into_inner(self) -> T {
        self.val
    }
}

impl<T> Debug for Cell<T> {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        __exr_dbg_begin::<()>(f, "Cell", 0);
        __exr_dbg_item::<()>(f, 0, "value");
        __exr_debug(&self.val, f);
        __exr_dbg_item_end::<()>(f);
        __exr_dbg_end::<()>(f, 1, 0, false);
        Ok(())
    }
}

impl<T> Debug for Vec<T> {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        __exr_dbg_begin::<()>(f, "", 2);
        let mut i = 0;
        while i < self.len {
            __exr_dbg_item::<()>(f, i, "");
            unsafe {
                __exr_debug(&*self.ptr.add(i), f);
            }
            __exr_dbg_item_end::<()>(f);
            i += 1;
        }
        if self.len == 0 && f.alt {
            // 空なら `[]`
            f.indent -= 1;
            f.buf.pop_byte();
            f.buf.push(']');
            return Ok(());
        }
        __exr_dbg_end::<()>(f, self.len, 2, false);
        Ok(())
    }
}

impl String {
    fn pop_byte(&mut self) {
        self.vec.len -= 1;
    }
}
// --- 順序 (Ordering / 大小比較の glue。型ごとの比較の本体は codegen が作る __exr_cmp) ---

// 演算子の trait (`impl Add for V`)。`a + b` は codegen が `a.add(b)` にする (右辺の型は impl の add の引数で決まる)
pub trait Add {
    type Output;
    fn add(self, rhs: Self) -> Self::Output;
}
pub trait Sub {
    type Output;
    fn sub(self, rhs: Self) -> Self::Output;
}
pub trait Mul {
    type Output;
    fn mul(self, rhs: Self) -> Self::Output;
}
pub trait Div {
    type Output;
    fn div(self, rhs: Self) -> Self::Output;
}
pub trait Rem {
    type Output;
    fn rem(self, rhs: Self) -> Self::Output;
}
// std::error::Error (メソッドは使わない: `Box<dyn Error>` は __DynError で表す)
pub trait Error {
    fn __err_mark(&self) {}
}

// `Box<dyn Error>`: 変換した時点で表示 ({}) と Debug ({:?}) の文字列にしておく
pub struct __DynError {
    msg: String,
    dbg: String,
}

impl Display for __DynError {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        __exr_fmt_str::<()>(f, self.msg.as_str());
        Ok(())
    }
}

impl Debug for __FmtError {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        f.buf.push_str("Error");
        Ok(())
    }
}
impl Debug for __DynError {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        f.buf.push_str(self.dbg.as_str());
        Ok(())
    }
}

fn __exr_dyn_error<E>(e: E) -> __DynError {
    __DynError { msg: format!("{}", e), dbg: format!("{:?}", e) }
}

// `fn main() -> Result<(), E>` が Err で終わったとき
fn __exr_main_err<E>(e: &E) {
    eprintln!("Error: {:?}", e);
    __core_process_exit(1);
}

// `impl IntoIterator for &Coll`: 名前だけ (for がユーザの into_iter を呼ぶ)
pub trait IntoIterator {
    fn __into_iter_mark(&self) {}
}

// `impl From<X> for S`: trait は名前だけ (型パラメータのある trait はまだないので、impl のシグネチャを使う)
// (宣言の引数の型は使わない。メソッドがないと trait ごと選ばれないので 1 つ置く)
pub trait From {
    fn from(t: Self) -> Self;
}

pub trait Neg {
    type Output;
    fn neg(self) -> Self::Output;
}
pub trait Not {
    type Output;
    fn not(self) -> Self::Output;
}
pub trait BitAnd {
    type Output;
    fn bitand(self, rhs: Self) -> Self::Output;
}
pub trait BitOr {
    type Output;
    fn bitor(self, rhs: Self) -> Self::Output;
}
pub trait BitXor {
    type Output;
    fn bitxor(self, rhs: Self) -> Self::Output;
}
pub trait Index {
    type Output;
    fn index(&self, i: Self) -> &Self::Output;
}
pub trait IndexMut {
    fn index_mut(&mut self, i: Self) -> &mut Self;
}
pub trait AddAssign {
    fn add_assign(&mut self, rhs: Self);
}
pub trait SubAssign {
    fn sub_assign(&mut self, rhs: Self);
}
pub trait MulAssign {
    fn mul_assign(&mut self, rhs: Self);
}
pub trait DivAssign {
    fn div_assign(&mut self, rhs: Self);
}
pub trait RemAssign {
    fn rem_assign(&mut self, rhs: Self);
}

pub trait PartialEq {
    fn eq(&self, other: &Self) -> bool;
}
pub trait Eq {
    fn __exr_eq_marker(&self) {}
}
// `Option<String>::as_deref()` 用 (String を &str に)
pub trait __AsStr {
    fn __as_str(&self) -> &str;
}

impl __AsStr for String {
    fn __as_str(&self) -> &str {
        self.as_str()
    }
}

pub trait Default {
    fn default() -> Self;
}
pub trait Clone {
    fn clone(&self) -> Self;
}
pub trait Copy {
    fn __exr_copy_marker(&self) {}
}
pub trait PartialOrd {
    fn partial_cmp(&self, other: &Self) -> Option<Ordering>;
}
pub trait Ord {
    fn cmp(&self, other: &Self) -> Ordering;
}

#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Hash)]
pub enum Ordering {
    Less = -1,
    Equal = 0,
    Greater = 1,
}

impl Ordering {
    pub fn reverse(self) -> Ordering {
        match self {
            Ordering::Less => Ordering::Greater,
            Ordering::Equal => Ordering::Equal,
            Ordering::Greater => Ordering::Less,
        }
    }
    pub fn then(self, o: Ordering) -> Ordering {
        match self {
            Ordering::Equal => o,
            x => x,
        }
    }
    pub fn then_with<F: FnOnce() -> Ordering>(self, f: F) -> Ordering {
        match self {
            Ordering::Equal => f(),
            x => x,
        }
    }
    pub fn is_eq(self) -> bool {
        __exr_ord_i32::<()>(&self) == 0
    }
    pub fn is_ne(self) -> bool {
        __exr_ord_i32::<()>(&self) != 0
    }
    pub fn is_lt(self) -> bool {
        __exr_ord_i32::<()>(&self) < 0
    }
    pub fn is_le(self) -> bool {
        __exr_ord_i32::<()>(&self) <= 0
    }
    pub fn is_gt(self) -> bool {
        __exr_ord_i32::<()>(&self) > 0
    }
    pub fn is_ge(self) -> bool {
        __exr_ord_i32::<()>(&self) >= 0
    }
}

#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
pub struct Reverse<T>(pub T);

impl<T> PartialOrd for Reverse<T> {
    fn partial_cmp(&self, o: &Reverse<T>) -> Option<Ordering> {
        Some(__exr_cmp_m::<T>(&o.0, &self.0))
    }
}
impl<T> Ord for Reverse<T> {
    fn cmp(&self, o: &Reverse<T>) -> Ordering {
        __exr_cmp_m::<T>(&o.0, &self.0)
    }
}

// a と b を比べて -1 / 0 / 1
fn __exr_cmp<T>(a: &T, b: &T) -> i32 {
    0
}

// a == b (Box を通した再帰型の derive(PartialEq) 用。本体は codegen が作る)
fn __exr_eq<T>(a: &T, b: &T) -> bool {
    false
}

fn __exr_ordering<G>(c: i32) -> Ordering {
    if c < 0 {
        Ordering::Less
    } else if c > 0 {
        Ordering::Greater
    } else {
        Ordering::Equal
    }
}

fn __exr_cmp_m<T>(a: &T, b: &T) -> Ordering {
    __exr_ordering::<()>(__exr_cmp::<T>(a, b))
}

// 浮動小数点の partial_cmp: NaN があれば None (T は f64 / f32。型名を書くと f64 の impl 一式を引くのでジェネリック)
fn __exr_pcmp_fl<T>(a: T, b: T) -> Option<Ordering> {
    if a < b {
        Some(Ordering::Less)
    } else if a > b {
        Some(Ordering::Greater)
    } else if a == b {
        Some(Ordering::Equal)
    } else {
        None
    }
}

fn __exr_pcmp_m<T>(a: &T, b: &T) -> Option<Ordering> {
    Some(__exr_cmp_m::<T>(a, b))
}

fn __exr_ord_i32<G>(o: &Ordering) -> i32 {
    match *o {
        Ordering::Less => -1,
        Ordering::Equal => 0,
        Ordering::Greater => 1,
    }
}

// `a < b` (型の違う PartialOrd): Less / Equal / Greater を -1 / 0 / 1、None を 2 に
fn __exr_pord_code<G>(o: &Option<Ordering>) -> i32 {
    match *o {
        Some(x) => __exr_ord_i32::<()>(&x),
        None => 2,
    }
}

fn __exr_pord_i32<G>(o: &Option<Ordering>) -> i32 {
    match *o {
        Some(x) => __exr_ord_i32::<()>(&x),
        None => 0,
    }
}

// Ord::max / min (`a.max(b)` の a が整数でないとき)
fn __exr_max<T>(a: T, b: T) -> T {
    if __exr_cmp::<T>(&a, &b) > 0 { a } else { b }
}

fn __exr_min<T>(a: T, b: T) -> T {
    if __exr_cmp::<T>(&a, &b) <= 0 { a } else { b }
}

// --- HashMap<K, V> (オープンアドレス法・線形探索。ハッシュは型ごとに codegen が作る __exr_hash) --

fn __exr_hash<T>(x: &T) -> u64 {
    0
}

fn __exr_hash_bytes<G>(b: &[u8]) -> u64 {
    // FNV-1a
    let mut h: u64 = 0xcbf29ce484222325;
    for &c in b {
        h = (h ^ c as u64).wrapping_mul(0x100000001b3);
    }
    h
}

pub struct HashMap<K, V> {
    // 0 = 空, 1 = 使用中, 2 = 削除済み
    st: *mut u8,
    ks: *mut K,
    vs: *mut V,
    cap: usize,
    len: usize,
    used: usize,
}

// (同じ容量・同じ位置に写すので、反復の順も元と同じ)
impl<K: Clone, V: Clone> HashMap<K, V> {
    pub fn clone(&self) -> HashMap<K, V> {
        let mut m = HashMap::new();
        if self.cap == 0 {
            return m;
        }
        m.alloc(self.cap);
        let mut i = 0;
        while i < self.cap {
            unsafe {
                let s = *self.st.add(i);
                if s == 1 {
                    m.ks.add(i).write((*self.ks.add(i)).clone());
                    m.vs.add(i).write((*self.vs.add(i)).clone());
                }
                m.st.add(i).write(s);
            }
            i += 1;
        }
        m.len = self.len;
        m.used = self.used;
        m
    }
}

impl<K, V> HashMap<K, V> {
    // `HashMap::from([(k, v), ..])` (codegen が配列を vec![..] にして渡す)
    pub fn from(v: Vec<(K, V)>) -> HashMap<K, V> {
        let mut m = HashMap::new();
        let mut v = v;
        v.reverse();
        while let Some((k, x)) = v.pop() {
            m.insert(k, x);
        }
        m
    }
    pub fn new() -> HashMap<K, V> {
        HashMap {
            st: core::ptr::null_mut(),
            ks: core::ptr::null_mut(),
            vs: core::ptr::null_mut(),
            cap: 0,
            len: 0,
            used: 0,
        }
    }
    pub fn with_capacity(n: usize) -> HashMap<K, V> {
        let mut m = HashMap::new();
        let mut c = 8;
        while c * 3 < n * 4 {
            c *= 2;
        }
        m.alloc(c);
        m
    }
    pub fn len(&self) -> usize {
        self.len
    }
    pub fn is_empty(&self) -> bool {
        self.len == 0
    }
    fn alloc(&mut self, c: usize) {
        let ks = core::mem::size_of::<K>();
        let vs = core::mem::size_of::<V>();
        self.st = unsafe { __exr_realloc(core::ptr::null_mut(), c) };
        self.ks = unsafe { __exr_realloc(core::ptr::null_mut(), if ks == 0 { 1 } else { c * ks }) } as *mut K;
        self.vs = unsafe { __exr_realloc(core::ptr::null_mut(), if vs == 0 { 1 } else { c * vs }) } as *mut V;
        let mut i = 0;
        while i < c {
            unsafe {
                self.st.add(i).write(0);
            }
            i += 1;
        }
        self.cap = c;
        self.len = 0;
        self.used = 0;
    }
    // (見つかった位置, 見つかったか)。見つからなければ入れられる位置
    fn find(&self, k: &K) -> (usize, bool) {
        let mask = self.cap - 1;
        let mut i = (__exr_hash(k) as usize) & mask;
        let mut free = self.cap;
        loop {
            let s = unsafe { *self.st.add(i) };
            if s == 0 {
                return (if free < self.cap { free } else { i }, false);
            }
            if s == 2 {
                if free == self.cap {
                    free = i;
                }
            } else if unsafe { *self.ks.add(i) == *k } {
                return (i, true);
            }
            i = (i + 1) & mask;
        }
    }
    fn grow(&mut self) {
        if self.cap != 0 && (self.used + 1) * 4 <= self.cap * 3 {
            return;
        }
        let (ost, oks, ovs, ocap) = (self.st, self.ks, self.vs, self.cap);
        let nc = if ocap == 0 { 8 } else if self.len * 2 >= ocap { ocap * 2 } else { ocap };
        self.alloc(nc);
        let mut i = 0;
        while i < ocap {
            if unsafe { *ost.add(i) } == 1 {
                let k = unsafe { oks.add(i).read() };
                let v = unsafe { ovs.add(i).read() };
                let (j, _) = self.find(&k);
                unsafe {
                    self.st.add(j).write(1);
                    self.ks.add(j).write(k);
                    self.vs.add(j).write(v);
                }
                self.len += 1;
                self.used += 1;
            }
            i += 1;
        }
        if ocap != 0 {
            unsafe {
                __exr_free(ost);
                __exr_free(oks as *mut u8);
                __exr_free(ovs as *mut u8);
            }
        }
    }
    pub fn insert(&mut self, k: K, v: V) -> Option<V> {
        self.grow();
        let (i, found) = self.find(&k);
        if found {
            let old = unsafe { self.vs.add(i).read() };
            unsafe {
                self.vs.add(i).write(v);
            }
            drop(k);
            return Some(old);
        }
        unsafe {
            if *self.st.add(i) == 0 {
                self.used += 1;
            }
            self.st.add(i).write(1);
            self.ks.add(i).write(k);
            self.vs.add(i).write(v);
        }
        self.len += 1;
        None
    }
    pub fn get(&self, k: &K) -> Option<&V> {
        if self.len == 0 {
            return None;
        }
        let (i, found) = self.find(k);
        if found {
            unsafe { Some(&*self.vs.add(i)) }
        } else {
            None
        }
    }
    pub fn get_mut(&mut self, k: &K) -> Option<&mut V> {
        if self.len == 0 {
            return None;
        }
        let (i, found) = self.find(k);
        if found {
            unsafe { Some(&mut *self.vs.add(i)) }
        } else {
            None
        }
    }
    pub fn contains_key(&self, k: &K) -> bool {
        if self.len == 0 {
            return false;
        }
        let (_, found) = self.find(k);
        found
    }
    pub fn remove(&mut self, k: &K) -> Option<V> {
        if self.len == 0 {
            return None;
        }
        let (i, found) = self.find(k);
        if !found {
            return None;
        }
        unsafe {
            self.st.add(i).write(2);
            __exr_drop_in_place(self.ks.add(i));
        }
        self.len -= 1;
        unsafe { Some(self.vs.add(i).read()) }
    }
    // f が false を返した組を消す
    pub fn retain<F: FnMut(&K, &mut V) -> bool>(&mut self, f: F) {
        let mut f = f;
        let mut i = 0;
        while i < self.cap {
            if unsafe { *self.st.add(i) } == 1 {
                let keep = unsafe { f(&*self.ks.add(i), &mut *self.vs.add(i)) };
                if !keep {
                    unsafe {
                        self.st.add(i).write(2);
                        __exr_drop_in_place(self.ks.add(i));
                        __exr_drop_in_place(self.vs.add(i));
                    }
                    self.len -= 1;
                }
            }
            i += 1;
        }
    }
    // 全部の組を取り出して空にする
    pub fn drain(&mut self) -> IntoIter<(K, V)> {
        let mut v = Vec::with_capacity(self.len);
        let mut i = 0;
        while i < self.cap {
            if unsafe { *self.st.add(i) } == 1 {
                unsafe {
                    v.push((self.ks.add(i).read(), self.vs.add(i).read()));
                }
            }
            unsafe {
                self.st.add(i).write(0);
            }
            i += 1;
        }
        self.len = 0;
        self.used = 0;
        v.into_iter()
    }
    pub fn extend<I: Iterator<Item = (K, V)>>(&mut self, it: I) {
        let mut it = it;
        while let Some((k, v)) = it.next() {
            self.insert(k, v);
        }
    }
    pub fn clear(&mut self) {
        let mut i = 0;
        while i < self.cap {
            if unsafe { *self.st.add(i) } == 1 {
                unsafe {
                    __exr_drop_in_place(self.ks.add(i));
                    __exr_drop_in_place(self.vs.add(i));
                }
            }
            unsafe {
                self.st.add(i).write(0);
            }
            i += 1;
        }
        self.len = 0;
        self.used = 0;
    }
    pub fn entry(&mut self, k: K) -> Entry<K, V> {
        self.grow();
        let (i, found) = self.find(&k);
        Entry {
            map: self,
            key: Some(k),
            idx: i,
            found: found,
        }
    }
    pub fn iter(&self) -> HmIter<K, V> {
        HmIter {
            st: self.st as *const u8,
            ks: self.ks as *const K,
            vs: self.vs as *const V,
            cap: self.cap,
            i: 0,
        }
    }
    pub fn iter_mut(&mut self) -> HmIterMut<K, V> {
        HmIterMut {
            st: self.st as *const u8,
            ks: self.ks as *const K,
            vs: self.vs,
            cap: self.cap,
            i: 0,
        }
    }
    pub fn keys(&self) -> HmKeys<K, V> {
        HmKeys { it: self.iter() }
    }
    pub fn values(&self) -> HmValues<K, V> {
        HmValues { it: self.iter() }
    }
    pub fn values_mut(&mut self) -> HmValuesMut<K, V> {
        HmValuesMut { it: self.iter_mut() }
    }
    pub fn into_iter(self) -> HmIntoIter<K, V> {
        HmIntoIter { m: self, i: 0 }
    }
}

impl<K, V> Drop for HashMap<K, V> {
    fn drop(&mut self) {
        if self.cap == 0 {
            return;
        }
        self.clear();
        unsafe {
            __exr_free(self.st);
            __exr_free(self.ks as *mut u8);
            __exr_free(self.vs as *mut u8);
        }
    }
}

pub struct Entry<K, V> {
    map: &mut HashMap<K, V>,
    key: Option<K>,
    idx: usize,
    found: bool,
}

impl<K, V> Entry<K, V> {
    pub fn or_insert(self, v: V) -> &mut V {
        let m = self.map;
        let i = self.idx;
        let mut key = self.key;
        if self.found {
            drop(v);
        } else {
            unsafe {
                if *m.st.add(i) == 0 {
                    m.used += 1;
                }
                m.st.add(i).write(1);
                m.ks.add(i).write(key.take().unwrap());
                m.vs.add(i).write(v);
            }
            m.len += 1;
        }
        drop(key);
        unsafe { &mut *m.vs.add(i) }
    }
    pub fn or_insert_with<F: FnOnce() -> V>(self, f: F) -> &mut V {
        if self.found {
            let m = self.map;
            let i = self.idx;
            drop(self.key);
            unsafe { &mut *m.vs.add(i) }
        } else {
            self.or_insert(f())
        }
    }
    pub fn or_default(self) -> &mut V {
        if self.found {
            let m = self.map;
            let i = self.idx;
            drop(self.key);
            unsafe { &mut *m.vs.add(i) }
        } else {
            self.or_insert(__exr_default::<V>())
        }
    }
    pub fn and_modify<F: FnOnce(&mut V)>(self, f: F) -> Entry<K, V> {
        if self.found {
            unsafe {
                f(&mut *self.map.vs.add(self.idx));
            }
        }
        self
    }
}

pub struct HmIter<K, V> {
    st: *const u8,
    ks: *const K,
    vs: *const V,
    cap: usize,
    i: usize,
}

impl<K, V> Iterator for HmIter<K, V> {
    type Item = (&K, &V);
    fn next(&mut self) -> Option<(&K, &V)> {
        while self.i < self.cap {
            let i = self.i;
            self.i += 1;
            if unsafe { *self.st.add(i) } == 1 {
                return unsafe { Some((&*self.ks.add(i), &*self.vs.add(i))) };
            }
        }
        None
    }
}

pub struct HmIterMut<K, V> {
    st: *const u8,
    ks: *const K,
    vs: *mut V,
    cap: usize,
    i: usize,
}

impl<K, V> Iterator for HmIterMut<K, V> {
    type Item = (&K, &mut V);
    fn next(&mut self) -> Option<(&K, &mut V)> {
        while self.i < self.cap {
            let i = self.i;
            self.i += 1;
            if unsafe { *self.st.add(i) } == 1 {
                return unsafe { Some((&*self.ks.add(i), &mut *self.vs.add(i))) };
            }
        }
        None
    }
}

pub struct HmKeys<K, V> {
    it: HmIter<K, V>,
}

impl<K, V> Iterator for HmKeys<K, V> {
    type Item = &K;
    fn next(&mut self) -> Option<&K> {
        match self.it.next() {
            Some((k, _)) => Some(k),
            None => None,
        }
    }
}

pub struct HmValues<K, V> {
    it: HmIter<K, V>,
}

impl<K, V> Iterator for HmValues<K, V> {
    type Item = &V;
    fn next(&mut self) -> Option<&V> {
        match self.it.next() {
            Some((_, v)) => Some(v),
            None => None,
        }
    }
}

pub struct HmValuesMut<K, V> {
    it: HmIterMut<K, V>,
}

impl<K, V> Iterator for HmValuesMut<K, V> {
    type Item = &mut V;
    fn next(&mut self) -> Option<&mut V> {
        match self.it.next() {
            Some((_, v)) => Some(v),
            None => None,
        }
    }
}

pub struct HmIntoIter<K, V> {
    m: HashMap<K, V>,
    i: usize,
}

impl<K, V> Iterator for HmIntoIter<K, V> {
    type Item = (K, V);
    fn next(&mut self) -> Option<(K, V)> {
        while self.i < self.m.cap {
            let i = self.i;
            self.i += 1;
            if unsafe { *self.m.st.add(i) } == 1 {
                unsafe {
                    self.m.st.add(i).write(0);
                }
                self.m.len -= 1;
                return unsafe { Some((self.m.ks.add(i).read(), self.m.vs.add(i).read())) };
            }
        }
        None
    }
}

impl<K, V> Debug for HashMap<K, V> {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        __exr_dbg_begin::<()>(f, "", 3);
        let mut n = 0;
        let mut i = 0;
        while i < self.cap {
            if unsafe { *self.st.add(i) } == 1 {
                __exr_dbg_item::<()>(f, n, "");
                unsafe {
                    __exr_debug(&*self.ks.add(i), f);
                    f.buf.push_str(": ");
                    __exr_debug(&*self.vs.add(i), f);
                }
                __exr_dbg_item_end::<()>(f);
                n += 1;
            }
            i += 1;
        }
        __exr_dbg_end::<()>(f, n, 3, false);
        Ok(())
    }
}
impl<K, V> __FromIter for HashMap<K, V> {
    fn __from_iter<I: Iterator>(it: I) -> HashMap<K, V> {
        let mut it = it;
        let mut m = HashMap::new();
        while let Some((k, v)) = it.next() {
            m.insert(k, v);
        }
        m
    }
}

// --- HashSet<T> (HashMap<T, ()> の上に) ---

pub struct HashSet<T> {
    m: HashMap<T, ()>,
}

impl<T> HashSet<T> {
    pub fn new() -> HashSet<T> {
        HashSet { m: HashMap::new() }
    }
    pub fn extend<I: Iterator<Item = T>>(&mut self, it: I) {
        let mut it = it;
        while let Some(x) = it.next() {
            self.insert(x);
        }
    }
    pub fn from(v: Vec<T>) -> HashSet<T> {
        let mut s = HashSet::new();
        let mut v = v;
        v.reverse();
        while let Some(x) = v.pop() {
            s.insert(x);
        }
        s
    }
    pub fn with_capacity(n: usize) -> HashSet<T> {
        HashSet { m: HashMap::with_capacity(n) }
    }
    pub fn insert(&mut self, x: T) -> bool {
        self.m.insert(x, ()).is_none()
    }
    pub fn contains(&self, x: &T) -> bool {
        self.m.contains_key(x)
    }
    pub fn remove(&mut self, x: &T) -> bool {
        self.m.remove(x).is_some()
    }
    pub fn len(&self) -> usize {
        self.m.len()
    }
    pub fn is_empty(&self) -> bool {
        self.m.len() == 0
    }
    pub fn clear(&mut self) {
        self.m.clear();
    }
    pub fn iter(&self) -> HmKeys<T, ()> {
        self.m.keys()
    }
    pub fn into_iter(self) -> SetIntoIter<T> {
        SetIntoIter { it: self.m.into_iter() }
    }
    pub fn get(&self, x: &T) -> Option<&T> {
        let mut it = self.m.keys();
        while let Some(k) = it.next() {
            if *k == *x {
                return Some(k);
            }
        }
        None
    }
    // 和・積・差 (std はイテレータを返す。ここでは要素の参照の IntoIter)
    pub fn union(&self, o: &HashSet<T>) -> IntoIter<&T> {
        let mut r = Vec::new();
        let mut a = self.m.keys();
        while let Some(x) = a.next() {
            r.push(x);
        }
        let mut b = o.m.keys();
        while let Some(x) = b.next() {
            if !self.m.contains_key(x) {
                r.push(x);
            }
        }
        r.into_iter()
    }
    pub fn intersection(&self, o: &HashSet<T>) -> IntoIter<&T> {
        let mut r = Vec::new();
        let mut a = self.m.keys();
        while let Some(x) = a.next() {
            if o.m.contains_key(x) {
                r.push(x);
            }
        }
        r.into_iter()
    }
    pub fn difference(&self, o: &HashSet<T>) -> IntoIter<&T> {
        let mut r = Vec::new();
        let mut a = self.m.keys();
        while let Some(x) = a.next() {
            if !o.m.contains_key(x) {
                r.push(x);
            }
        }
        r.into_iter()
    }
    pub fn is_subset(&self, o: &HashSet<T>) -> bool {
        let mut a = self.m.keys();
        while let Some(x) = a.next() {
            if !o.m.contains_key(x) {
                return false;
            }
        }
        true
    }
}

pub struct SetIntoIter<T> {
    it: HmIntoIter<T, ()>,
}

impl<T> Iterator for SetIntoIter<T> {
    type Item = T;
    fn next(&mut self) -> Option<T> {
        match self.it.next() {
            Some((k, _)) => Some(k),
            None => None,
        }
    }
}

impl<T> __FromIter for HashSet<T> {
    fn __from_iter<I: Iterator>(it: I) -> HashSet<T> {
        let mut it = it;
        let mut s = HashSet::new();
        while let Some(x) = it.next() {
            s.insert(x);
        }
        s
    }
}

impl<T> Debug for HashSet<T> {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        __exr_dbg_begin::<()>(f, "", 3);
        let mut n = 0;
        let mut it = self.m.keys();
        while let Some(k) = it.next() {
            __exr_dbg_item::<()>(f, n, "");
            __exr_debug(k, f);
            __exr_dbg_item_end::<()>(f);
            n += 1;
        }
        __exr_dbg_end::<()>(f, n, 3, false);
        Ok(())
    }
}

// --- BTreeMap<K, V> / BTreeSet<T> (キーの順に並べた Vec と二分探索。木ではないが、並びと API は std と同じ) ---

pub struct BTreeMap<K, V> {
    ks: Vec<K>,
    vs: Vec<V>,
}

impl<K, V> BTreeMap<K, V> {
    pub fn extend<I: Iterator<Item = (K, V)>>(&mut self, it: I) {
        let mut it = it;
        while let Some((k, v)) = it.next() {
            self.insert(k, v);
        }
    }
    pub fn from(v: Vec<(K, V)>) -> BTreeMap<K, V> {
        let mut m = BTreeMap::new();
        let mut v = v;
        v.reverse();
        while let Some((k, x)) = v.pop() {
            m.insert(k, x);
        }
        m
    }
    pub fn new() -> BTreeMap<K, V> {
        BTreeMap { ks: Vec::new(), vs: Vec::new() }
    }
    // (見つかった位置, 見つかったか)。見つからなければ入れる位置
    fn bt_find(&self, k: &K) -> (usize, bool) {
        let mut lo = 0;
        let mut hi = self.ks.len;
        while lo < hi {
            let mid = (lo + hi) / 2;
            let c = __exr_cmp::<K>(unsafe { &*self.ks.ptr.add(mid) }, k);
            if c == 0 {
                return (mid, true);
            } else if c < 0 {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        (lo, false)
    }
    pub fn insert(&mut self, k: K, v: V) -> Option<V> {
        let (i, found) = self.bt_find(&k);
        if found {
            drop(k);
            unsafe {
                let p = self.vs.ptr.add(i);
                let old = p.read();
                p.write(v);
                Some(old)
            }
        } else {
            self.ks.insert(i, k);
            self.vs.insert(i, v);
            None
        }
    }
    pub fn get(&self, k: &K) -> Option<&V> {
        let (i, found) = self.bt_find(k);
        if found { Some(unsafe { &*self.vs.ptr.add(i) }) } else { None }
    }
    pub fn get_mut(&mut self, k: &K) -> Option<&mut V> {
        let (i, found) = self.bt_find(k);
        if found { Some(unsafe { &mut *self.vs.ptr.add(i) }) } else { None }
    }
    pub fn contains_key(&self, k: &K) -> bool {
        self.bt_find(k).1
    }
    pub fn remove(&mut self, k: &K) -> Option<V> {
        let (i, found) = self.bt_find(k);
        if found {
            self.ks.remove(i);
            Some(self.vs.remove(i))
        } else {
            None
        }
    }
    pub fn len(&self) -> usize {
        self.ks.len
    }
    pub fn is_empty(&self) -> bool {
        self.ks.len == 0
    }
    pub fn clear(&mut self) {
        self.ks.clear();
        self.vs.clear();
    }
    pub fn iter(&self) -> BtIter<K, V> {
        BtIter { ks: self.ks.ptr as *const K, vs: self.vs.ptr as *const V, i: 0, len: self.ks.len }
    }
    // `m.range(a..b)` / `a..=b` / `a..`: 範囲のキーだけを順に
    pub fn range<R>(&self, r: R) -> BtIter<K, V> {
        let (a, b) = r.__bt_span(self);
        let b = if b < a { a } else { b };
        BtIter { ks: self.ks.ptr as *const K, vs: self.vs.ptr as *const V, i: a, len: b }
    }
    pub fn iter_mut(&mut self) -> BtIterMut<K, V> {
        BtIterMut { ks: self.ks.ptr as *const K, vs: self.vs.ptr, i: 0, len: self.ks.len }
    }
    pub fn keys(&self) -> Iter<K> {
        self.ks.iter()
    }
    pub fn values(&self) -> Iter<V> {
        self.vs.iter()
    }
    pub fn values_mut(&mut self) -> IterMut<V> {
        self.vs.iter_mut()
    }
    pub fn into_iter(self) -> BtIntoIter<K, V> {
        let mut m = self;
        let ks = Vec { ptr: m.ks.ptr, cap: m.ks.cap, len: m.ks.len };
        let vs = Vec { ptr: m.vs.ptr, cap: m.vs.cap, len: m.vs.len };
        m.ks.ptr = 0usize as *mut K;
        m.ks.cap = 0;
        m.ks.len = 0;
        m.vs.ptr = 0usize as *mut V;
        m.vs.cap = 0;
        m.vs.len = 0;
        BtIntoIter { k: ks.into_iter(), v: vs.into_iter() }
    }
    // `m[&k]`
    pub fn index(&self, k: &K) -> &V {
        match self.get(k) {
            Some(v) => v,
            None => panic!("key not found"),
        }
    }
    pub fn first_key_value(&self) -> Option<(&K, &V)> {
        if self.ks.len == 0 { None } else { Some(unsafe { (&*self.ks.ptr, &*self.vs.ptr) }) }
    }
    pub fn last_key_value(&self) -> Option<(&K, &V)> {
        let n = self.ks.len;
        if n == 0 { None } else { Some(unsafe { (&*self.ks.ptr.add(n - 1), &*self.vs.ptr.add(n - 1)) }) }
    }
    pub fn pop_first(&mut self) -> Option<(K, V)> {
        if self.ks.len == 0 { None } else { Some((self.ks.remove(0), self.vs.remove(0))) }
    }
    pub fn pop_last(&mut self) -> Option<(K, V)> {
        match self.ks.pop() {
            Some(k) => Some((k, self.vs.pop().unwrap())),
            None => None,
        }
    }
    pub fn entry(&mut self, k: K) -> BtEntry<K, V> {
        let (i, found) = self.bt_find(&k);
        BtEntry { map: self, key: Some(k), idx: i, found: found }
    }
}

pub struct BtEntry<K, V> {
    map: &mut BTreeMap<K, V>,
    key: Option<K>,
    idx: usize,
    found: bool,
}

impl<K, V> BtEntry<K, V> {
    pub fn or_insert(self, v: V) -> &mut V {
        let m = self.map;
        let i = self.idx;
        let mut key = self.key;
        if self.found {
            drop(v);
        } else {
            m.ks.insert(i, key.take().unwrap());
            m.vs.insert(i, v);
        }
        unsafe { &mut *m.vs.ptr.add(i) }
    }
    pub fn or_insert_with<F: FnOnce() -> V>(self, f: F) -> &mut V {
        let m = self.map;
        let i = self.idx;
        let mut key = self.key;
        if !self.found {
            m.ks.insert(i, key.take().unwrap());
            m.vs.insert(i, f());
        }
        unsafe { &mut *m.vs.ptr.add(i) }
    }
    pub fn or_default(self) -> &mut V {
        let m = self.map;
        let i = self.idx;
        let mut key = self.key;
        if !self.found {
            m.ks.insert(i, key.take().unwrap());
            m.vs.insert(i, __exr_default::<V>());
        }
        unsafe { &mut *m.vs.ptr.add(i) }
    }
    pub fn and_modify<F: FnOnce(&mut V)>(self, f: F) -> BtEntry<K, V> {
        let e = self;
        if e.found {
            f(unsafe { &mut *e.map.vs.ptr.add(e.idx) });
        }
        e
    }
}

pub struct BtIter<K, V> {
    ks: *const K,
    vs: *const V,
    i: usize,
    len: usize,
}

impl<K, V> Iterator for BtIter<K, V> {
    type Item = (&K, &V);
    fn next(&mut self) -> Option<(&K, &V)> {
        if self.i < self.len {
            self.i += 1;
            Some(unsafe { (&*self.ks.add(self.i - 1), &*self.vs.add(self.i - 1)) })
        } else {
            None
        }
    }
}

impl<K, V> BtIter<K, V> {
    pub fn next_back(&mut self) -> Option<(&K, &V)> {
        if self.i < self.len {
            self.len -= 1;
            Some(unsafe { (&*self.ks.add(self.len), &*self.vs.add(self.len)) })
        } else {
            None
        }
    }
}

pub struct BtIterMut<K, V> {
    ks: *const K,
    vs: *mut V,
    i: usize,
    len: usize,
}

impl<K, V> Iterator for BtIterMut<K, V> {
    type Item = (&K, &mut V);
    fn next(&mut self) -> Option<(&K, &mut V)> {
        if self.i < self.len {
            self.i += 1;
            Some(unsafe { (&*self.ks.add(self.i - 1), &mut *self.vs.add(self.i - 1)) })
        } else {
            None
        }
    }
}

pub struct BtIntoIter<K, V> {
    k: IntoIter<K>,
    v: IntoIter<V>,
}

impl<K, V> Iterator for BtIntoIter<K, V> {
    type Item = (K, V);
    fn next(&mut self) -> Option<(K, V)> {
        match self.k.next() {
            Some(k) => Some((k, self.v.next().unwrap())),
            None => None,
        }
    }
}

impl<K, V> __FromIter for BTreeMap<K, V> {
    fn __from_iter<I: Iterator>(it: I) -> BTreeMap<K, V> {
        let mut it = it;
        let mut m = BTreeMap::new();
        // (std の collect は同じキーなら後のキーと値を残す。insert はキーを残して値だけ替える)
        while let Some((k, v)) = it.next() {
            let (i, found) = m.bt_find(&k);
            if found {
                unsafe {
                    let pk = m.ks.ptr.add(i);
                    let pv = m.vs.ptr.add(i);
                    drop(pk.read());
                    drop(pv.read());
                    pk.write(k);
                    pv.write(v);
                }
            } else {
                m.ks.insert(i, k);
                m.vs.insert(i, v);
            }
        }
        m
    }
}

impl<K, V> Debug for BTreeMap<K, V> {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        __exr_dbg_begin::<()>(f, "", 3);
        let mut i = 0;
        while i < self.ks.len {
            __exr_dbg_item::<()>(f, i, "");
            unsafe {
                __exr_debug(&*self.ks.ptr.add(i), f);
                f.buf.push_str(": ");
                __exr_debug(&*self.vs.ptr.add(i), f);
            }
            __exr_dbg_item_end::<()>(f);
            i += 1;
        }
        __exr_dbg_end::<()>(f, self.ks.len, 3, false);
        Ok(())
    }
}

pub struct BTreeSet<T> {
    v: Vec<T>,
}

impl<T> BTreeSet<T> {
    pub fn new() -> BTreeSet<T> {
        BTreeSet { v: Vec::new() }
    }
    pub fn extend<I: Iterator<Item = T>>(&mut self, it: I) {
        let mut it = it;
        while let Some(x) = it.next() {
            self.insert(x);
        }
    }
    pub fn from(v: Vec<T>) -> BTreeSet<T> {
        let mut s = BTreeSet::new();
        let mut v = v;
        v.reverse();
        while let Some(x) = v.pop() {
            s.insert(x);
        }
        s
    }
    fn bs_find(&self, x: &T) -> (usize, bool) {
        let mut lo = 0;
        let mut hi = self.v.len;
        while lo < hi {
            let mid = (lo + hi) / 2;
            let c = __exr_cmp::<T>(unsafe { &*self.v.ptr.add(mid) }, x);
            if c == 0 {
                return (mid, true);
            } else if c < 0 {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        (lo, false)
    }
    pub fn insert(&mut self, x: T) -> bool {
        let (i, found) = self.bs_find(&x);
        if found {
            drop(x);
            false
        } else {
            self.v.insert(i, x);
            true
        }
    }
    pub fn contains(&self, x: &T) -> bool {
        self.bs_find(x).1
    }
    pub fn remove(&mut self, x: &T) -> bool {
        let (i, found) = self.bs_find(x);
        if found {
            self.v.remove(i);
        }
        found
    }
    pub fn len(&self) -> usize {
        self.v.len
    }
    pub fn is_empty(&self) -> bool {
        self.v.len == 0
    }
    pub fn clear(&mut self) {
        self.v.clear();
    }
    pub fn iter(&self) -> Iter<T> {
        self.v.iter()
    }
    pub fn into_iter(self) -> IntoIter<T> {
        let mut s = self;
        let v = Vec { ptr: s.v.ptr, cap: s.v.cap, len: s.v.len };
        s.v.ptr = 0usize as *mut T;
        s.v.cap = 0;
        s.v.len = 0;
        v.into_iter()
    }
    pub fn first(&self) -> Option<&T> {
        self.v.first()
    }
    pub fn last(&self) -> Option<&T> {
        self.v.last()
    }
    pub fn pop_first(&mut self) -> Option<T> {
        if self.v.len == 0 { None } else { Some(self.v.remove(0)) }
    }
    pub fn pop_last(&mut self) -> Option<T> {
        self.v.pop()
    }
}

impl<T> __FromIter for BTreeSet<T> {
    fn __from_iter<I: Iterator>(it: I) -> BTreeSet<T> {
        let mut it = it;
        let mut s = BTreeSet::new();
        // (std の collect は等しい要素なら後のものを残す。insert は前のものを残す)
        while let Some(x) = it.next() {
            let (i, found) = s.bs_find(&x);
            if found {
                unsafe {
                    let p = s.v.ptr.add(i);
                    drop(p.read());
                    p.write(x);
                }
            } else {
                s.v.insert(i, x);
            }
        }
        s
    }
}

impl<T> Debug for BTreeSet<T> {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        __exr_dbg_begin::<()>(f, "", 3);
        let mut i = 0;
        while i < self.v.len {
            __exr_dbg_item::<()>(f, i, "");
            unsafe {
                __exr_debug(&*self.v.ptr.add(i), f);
            }
            __exr_dbg_item_end::<()>(f);
            i += 1;
        }
        __exr_dbg_end::<()>(f, self.v.len, 3, false);
        Ok(())
    }
}

// --- VecDeque<T> (リングバッファ) ---

pub struct VecDeque<T> {
    ptr: *mut T,
    cap: usize,
    head: usize,
    len: usize,
}

impl<T> VecDeque<T> {
    pub fn new() -> VecDeque<T> {
        VecDeque { ptr: core::ptr::null_mut(), cap: 0, head: 0, len: 0 }
    }
    pub fn from(v: Vec<T>) -> VecDeque<T> {
        let mut d = VecDeque::with_capacity(v.len());
        let mut v = v;
        v.reverse();
        while let Some(x) = v.pop() {
            d.push_back(x);
        }
        d
    }
    pub fn with_capacity(n: usize) -> VecDeque<T> {
        let mut d = VecDeque::new();
        d.dq_grow(n);
        d
    }
    fn dq_at(&self, i: usize) -> *mut T {
        let mut j = self.head + i;
        if j >= self.cap {
            j -= self.cap;
        }
        unsafe { self.ptr.add(j) }
    }
    // 容量を n 以上にし、要素を先頭から詰め直す
    fn dq_grow(&mut self, n: usize) {
        if n <= self.cap {
            return;
        }
        let c = if n < 4 { 4 } else { n };
        let sz = core::mem::size_of::<T>();
        let np = unsafe { __exr_realloc(0usize as *mut u8, if sz == 0 { 1 } else { c * sz }) } as *mut T;
        let mut i = 0;
        while i < self.len {
            unsafe {
                np.add(i).write(self.dq_at(i).read());
            }
            i += 1;
        }
        if !self.ptr.is_null() {
            unsafe {
                __exr_free(self.ptr as *mut u8);
            }
        }
        self.ptr = np;
        self.cap = c;
        self.head = 0;
    }
    pub fn push_back(&mut self, x: T) {
        if self.len == self.cap {
            self.dq_grow(if self.cap == 0 { 4 } else { self.cap * 2 });
        }
        unsafe {
            self.dq_at(self.len).write(x);
        }
        self.len += 1;
    }
    pub fn push_front(&mut self, x: T) {
        if self.len == self.cap {
            self.dq_grow(if self.cap == 0 { 4 } else { self.cap * 2 });
        }
        self.head = if self.head == 0 { self.cap - 1 } else { self.head - 1 };
        unsafe {
            self.ptr.add(self.head).write(x);
        }
        self.len += 1;
    }
    pub fn pop_front(&mut self) -> Option<T> {
        if self.len == 0 {
            return None;
        }
        let x = unsafe { self.ptr.add(self.head).read() };
        self.head += 1;
        if self.head == self.cap {
            self.head = 0;
        }
        self.len -= 1;
        Some(x)
    }
    pub fn pop_back(&mut self) -> Option<T> {
        if self.len == 0 {
            return None;
        }
        self.len -= 1;
        Some(unsafe { self.dq_at(self.len).read() })
    }
    pub fn front(&self) -> Option<&T> {
        if self.len == 0 { None } else { Some(unsafe { &*self.dq_at(0) }) }
    }
    pub fn back(&self) -> Option<&T> {
        if self.len == 0 { None } else { Some(unsafe { &*self.dq_at(self.len - 1) }) }
    }
    pub fn front_mut(&mut self) -> Option<&mut T> {
        if self.len == 0 { None } else { Some(unsafe { &mut *self.dq_at(0) }) }
    }
    pub fn back_mut(&mut self) -> Option<&mut T> {
        if self.len == 0 { None } else { Some(unsafe { &mut *self.dq_at(self.len - 1) }) }
    }
    pub fn get(&self, i: usize) -> Option<&T> {
        if i < self.len { Some(unsafe { &*self.dq_at(i) }) } else { None }
    }
    pub fn get_mut(&mut self, i: usize) -> Option<&mut T> {
        if i < self.len { Some(unsafe { &mut *self.dq_at(i) }) } else { None }
    }
    // `d[i]` (Index)
    pub fn index(&self, i: usize) -> &T {
        if i >= self.len {
            panic!("index out of bounds");
        }
        unsafe { &*self.dq_at(i) }
    }
    pub fn index_mut(&mut self, i: usize) -> &mut T {
        if i >= self.len {
            panic!("index out of bounds");
        }
        unsafe { &mut *self.dq_at(i) }
    }
    pub fn len(&self) -> usize {
        self.len
    }
    pub fn is_empty(&self) -> bool {
        self.len == 0
    }
    pub fn clear(&mut self) {
        while let Some(x) = self.pop_front() {
            drop(x);
        }
    }
    pub fn iter(&self) -> DqIter<T> {
        DqIter { d: self as *const VecDeque<T>, i: 0, n: self.len }
    }
    pub fn into_iter(self) -> DqIntoIter<T> {
        DqIntoIter { d: self }
    }
}

impl<T: PartialEq> VecDeque<T> {
    pub fn contains(&self, x: &T) -> bool {
        let mut i = 0;
        while i < self.len {
            if unsafe { *self.dq_at(i) == *x } {
                return true;
            }
            i += 1;
        }
        false
    }
}

impl<T> Drop for VecDeque<T> {
    fn drop(&mut self) {
        self.clear();
        if !self.ptr.is_null() {
            unsafe {
                __exr_free(self.ptr as *mut u8);
            }
        }
    }
}

pub struct DqIter<T> {
    d: *const VecDeque<T>,
    i: usize,
    n: usize,
}

impl<T> Iterator for DqIter<T> {
    type Item = &T;
    fn next(&mut self) -> Option<&T> {
        if self.i < self.n {
            self.i += 1;
            Some(unsafe { &*(*self.d).dq_at(self.i - 1) })
        } else {
            None
        }
    }
}

impl<T> DqIter<T> {
    pub fn next_back(&mut self) -> Option<&T> {
        if self.i < self.n {
            self.n -= 1;
            Some(unsafe { &*(*self.d).dq_at(self.n) })
        } else {
            None
        }
    }
}

pub struct DqIntoIter<T> {
    d: VecDeque<T>,
}

impl<T> Iterator for DqIntoIter<T> {
    type Item = T;
    fn next(&mut self) -> Option<T> {
        self.d.pop_front()
    }
}

impl<T> __FromIter for VecDeque<T> {
    fn __from_iter<I: Iterator>(it: I) -> VecDeque<T> {
        let mut it = it;
        let mut d = VecDeque::new();
        while let Some(x) = it.next() {
            d.push_back(x);
        }
        d
    }
}

impl<T> Debug for VecDeque<T> {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        __exr_dbg_begin::<()>(f, "", 2);
        let mut i = 0;
        while i < self.len {
            __exr_dbg_item::<()>(f, i, "");
            unsafe {
                __exr_debug(&*self.dq_at(i), f);
            }
            __exr_dbg_item_end::<()>(f);
            i += 1;
        }
        if self.len == 0 && f.alt {
            f.indent -= 1;
            f.buf.pop_byte();
            f.buf.push(']');
            return Ok(());
        }
        __exr_dbg_end::<()>(f, self.len, 2, false);
        Ok(())
    }
}

// --- BinaryHeap<T> (最大ヒープ。std と同じ sift の手順なので、iter / into_vec の並びも std と同じ) ---

pub struct BinaryHeap<T> {
    data: Vec<T>,
}

impl<T> BinaryHeap<T> {
    pub fn new() -> BinaryHeap<T> {
        BinaryHeap { data: Vec::new() }
    }
    pub fn with_capacity(n: usize) -> BinaryHeap<T> {
        BinaryHeap { data: Vec::with_capacity(n) }
    }
    pub fn from(v: Vec<T>) -> BinaryHeap<T> {
        let mut h = BinaryHeap { data: v };
        h.rebuild();
        h
    }
    pub fn len(&self) -> usize {
        self.data.len
    }
    pub fn is_empty(&self) -> bool {
        self.data.len == 0
    }
    pub fn capacity(&self) -> usize {
        self.data.cap
    }
    pub fn clear(&mut self) {
        self.data.clear();
    }
    pub fn peek(&self) -> Option<&T> {
        if self.data.len == 0 {
            None
        } else {
            Some(unsafe { &*self.data.ptr })
        }
    }
    pub fn push(&mut self, x: T) {
        let old = self.data.len;
        self.data.push(x);
        self.sift_up(0, old);
    }
    pub fn pop(&mut self) -> Option<T> {
        match self.data.pop() {
            None => None,
            Some(x) => {
                let mut item = x;
                if self.data.len > 0 {
                    unsafe {
                        let top = self.data.ptr.read();
                        self.data.ptr.write(item);
                        item = top;
                    }
                    self.sift_down_to_bottom(0);
                }
                Some(item)
            }
        }
    }
    pub fn into_vec(self) -> Vec<T> {
        // 中身の Vec を取り出す (h の drop では何も解放しないよう空にしておく)
        let mut h = self;
        let v = Vec { ptr: h.data.ptr, cap: h.data.cap, len: h.data.len };
        h.data.ptr = 0usize as *mut T;
        h.data.cap = 0;
        h.data.len = 0;
        v
    }
    pub fn into_sorted_vec(self) -> Vec<T> {
        let mut h = self;
        let mut end = h.data.len;
        while end > 1 {
            end -= 1;
            h.data.swap(0, end);
            h.sift_down_range(0, end);
        }
        h.into_vec()
    }
    pub fn iter(&self) -> Iter<T> {
        self.data.iter()
    }
    pub fn into_iter(self) -> IntoIter<T> {
        self.into_vec().into_iter()
    }
    // std と同じ: 要素の多い方に少ない方を足し、足した末尾を rebuild_tail で直す
    pub fn append(&mut self, other: &mut BinaryHeap<T>) {
        if self.data.len < other.data.len {
            let (p, c, l) = (self.data.ptr, self.data.cap, self.data.len);
            self.data.ptr = other.data.ptr;
            self.data.cap = other.data.cap;
            self.data.len = other.data.len;
            other.data.ptr = p;
            other.data.cap = c;
            other.data.len = l;
        }
        let start = self.data.len;
        self.data.append(&mut other.data);
        self.rebuild_tail(start);
    }
    pub fn extend<I: Iterator<Item = T>>(&mut self, it: I) {
        let start = self.data.len;
        self.data.extend(it);
        self.rebuild_tail(start);
    }
    pub fn __extend_ref<I: Iterator<Item = &T>>(&mut self, it: I) {
        let start = self.data.len;
        self.data.__extend_ref(it);
        self.rebuild_tail(start);
    }
    // std と同じ判定: 足した数が多ければ全体を作り直し、少なければ 1 つずつ sift_up
    fn rebuild_tail(&mut self, start: usize) {
        let len = self.data.len;
        if start == len {
            return;
        }
        let tail = len - start;
        let rebuild = if start < tail {
            true
        } else if len <= 2048 {
            2 * len < tail * ((64 - start.leading_zeros() - 1) as usize)
        } else {
            2 * len < tail * 11
        };
        if rebuild {
            self.rebuild();
        } else {
            let mut i = start;
            while i < len {
                self.sift_up(0, i);
                i += 1;
            }
        }
    }
    // 穴 (hole) を上へ動かす: 親より大きい間だけ親を下ろす
    fn sift_up(&mut self, start: usize, pos: usize) -> usize {
        let p = self.data.ptr;
        let mut pos = pos;
        unsafe {
            let elem = p.add(pos).read();
            while pos > start {
                let parent = (pos - 1) / 2;
                if elem <= *p.add(parent) {
                    break;
                }
                p.add(pos).write(p.add(parent).read());
                pos = parent;
            }
            p.add(pos).write(elem);
        }
        pos
    }
    fn sift_down_range(&mut self, pos: usize, end: usize) {
        let p = self.data.ptr;
        let mut pos = pos;
        unsafe {
            let elem = p.add(pos).read();
            let mut child = 2 * pos + 1;
            while end >= 2 && child <= end - 2 {
                if *p.add(child) <= *p.add(child + 1) {
                    child += 1;
                }
                if elem >= *p.add(child) {
                    p.add(pos).write(elem);
                    return;
                }
                p.add(pos).write(p.add(child).read());
                pos = child;
                child = 2 * pos + 1;
            }
            if end >= 1 && child == end - 1 && elem < *p.add(child) {
                p.add(pos).write(p.add(child).read());
                pos = child;
            }
            p.add(pos).write(elem);
        }
    }
    fn sift_down_to_bottom(&mut self, pos: usize) {
        let end = self.data.len;
        let start = pos;
        let p = self.data.ptr;
        let mut pos = pos;
        unsafe {
            let elem = p.add(pos).read();
            let mut child = 2 * pos + 1;
            while end >= 2 && child <= end - 2 {
                if *p.add(child) <= *p.add(child + 1) {
                    child += 1;
                }
                p.add(pos).write(p.add(child).read());
                pos = child;
                child = 2 * pos + 1;
            }
            if end >= 1 && child == end - 1 {
                p.add(pos).write(p.add(child).read());
                pos = child;
            }
            p.add(pos).write(elem);
        }
        self.sift_up(start, pos);
    }
    fn rebuild(&mut self) {
        let mut n = self.data.len / 2;
        while n > 0 {
            n -= 1;
            let end = self.data.len;
            self.sift_down_range(n, end);
        }
    }
}

impl<T> __FromIter for BinaryHeap<T> {
    fn __from_iter<I: Iterator>(it: I) -> BinaryHeap<T> {
        let mut it = it;
        let mut v = Vec::new();
        while let Some(x) = it.next() {
            v.push(x);
        }
        BinaryHeap::from(v)
    }
}

impl<T> Debug for BinaryHeap<T> {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        __exr_debug(&self.data, f);
        Ok(())
    }
}

// --- &str の分割・検索 (split / split_whitespace / lines / trim / starts_with / ends_with / contains) ---

// 文字列の大小 (バイト列の辞書順): 負 / 0 / 正
fn __exr_str_cmp<G>(a: &str, b: &str) -> i32 {
    let x = a.as_bytes();
    let y = b.as_bytes();
    let mut i = 0;
    while i < x.len() && i < y.len() {
        if x[i] != y[i] {
            return if x[i] < y[i] { -1 } else { 1 };
        }
        i += 1;
    }
    if x.len() < y.len() {
        -1
    } else if x.len() > y.len() {
        1
    } else {
        0
    }
}

fn __exr_sub<G>(p: *const u8, n: usize) -> &str {
    unsafe { core::str::from_utf8_unchecked(core::slice::from_raw_parts(p, n)) }
}

pub struct Split {
    p: *const u8,
    len: usize,
    i: usize,
    sep: u8,
    // 0 = 区切り文字 1 個, 1 = 空白の連続 (split_whitespace), 2 = 行 (lines)
    mode: u8,
    done: bool,
    // 後ろから読み始めたか (lines の末尾の改行を 1 度だけ落とす)
    bk: bool,
}

impl Split {
    // rev() 用: 後ろの端 (len) を縮めながら読む
    pub fn next_back(&mut self) -> Option<&str> {
        if self.mode == 1 {
            while self.len > self.i && __exr_is_space::<()>(unsafe { *self.p.add(self.len - 1) }) {
                self.len -= 1;
            }
            if self.len <= self.i {
                return None;
            }
            let end = self.len;
            while self.len > self.i && !__exr_is_space::<()>(unsafe { *self.p.add(self.len - 1) }) {
                self.len -= 1;
            }
            return Some(__exr_sub::<()>(unsafe { self.p.add(self.len) }, end - self.len));
        }
        if self.done {
            return None;
        }
        if self.mode == 2 && !self.bk {
            self.bk = true;
            if self.len > self.i && unsafe { *self.p.add(self.len - 1) } == 10 {
                self.len -= 1;
            } else if self.len <= self.i {
                self.done = true;
                return None;
            }
        }
        self.bk = true;
        let end = self.len;
        let mut k = self.len;
        while k > self.i && unsafe { *self.p.add(k - 1) } != self.sep {
            k -= 1;
        }
        let st = k;
        if k > self.i {
            self.len = k - 1;
        } else {
            self.done = true;
        }
        let mut e = end;
        if self.mode == 2 && e > st && unsafe { *self.p.add(e - 1) } == 13 {
            e -= 1;
        }
        Some(__exr_sub::<()>(unsafe { self.p.add(st) }, e - st))
    }
}

impl Iterator for Split {
    type Item = &str;
    fn next(&mut self) -> Option<&str> {
        if self.mode == 1 {
            while self.i < self.len && __exr_is_space::<()>(unsafe { *self.p.add(self.i) }) {
                self.i += 1;
            }
            if self.i >= self.len {
                return None;
            }
            let st = self.i;
            while self.i < self.len && !__exr_is_space::<()>(unsafe { *self.p.add(self.i) }) {
                self.i += 1;
            }
            return Some(__exr_sub::<()>(unsafe { self.p.add(st) }, self.i - st));
        }
        if self.done {
            return None;
        }
        if self.mode == 2 && self.i >= self.len {
            return None;
        }
        // (フィールドをローカルに写して回す: ループの中で self を読み書きしない)
        let (p, len, sep) = (self.p, self.len, self.sep);
        let st = self.i;
        let mut i = st;
        while i < len && unsafe { *p.add(i) } != sep {
            i += 1;
        }
        let mut end = i;
        if i >= len {
            self.done = true;
            self.i = i;
        } else {
            self.i = i + 1;
        }
        // lines は末尾の \r も取る
        if self.mode == 2 && end > st && unsafe { *self.p.add(end - 1) } == 13 {
            end -= 1;
        }
        Some(__exr_sub::<()>(unsafe { self.p.add(st) }, end - st))
    }
}

// UTF-8 の i バイト目の文字と、そのバイト数 (Chars を使わない: イテレータの部品なしで使えるように)
fn __exr_decode_at<G>(p: *const u8, i: usize) -> (char, usize) {
    let b0 = unsafe { *p.add(i) } as u32;
    let (c, n) = if b0 < 0x80 {
        (b0, 1)
    } else if b0 < 0xE0 {
        ((b0 & 0x1F) << 6 | (unsafe { *p.add(i + 1) } as u32 & 0x3F), 2)
    } else if b0 < 0xF0 {
        (
            (b0 & 0x0F) << 12 | (unsafe { *p.add(i + 1) } as u32 & 0x3F) << 6 | (unsafe { *p.add(i + 2) } as u32 & 0x3F),
            3,
        )
    } else {
        (
            (b0 & 0x07) << 18
                | (unsafe { *p.add(i + 1) } as u32 & 0x3F) << 12
                | (unsafe { *p.add(i + 2) } as u32 & 0x3F) << 6
                | (unsafe { *p.add(i + 3) } as u32 & 0x3F),
            4,
        )
    };
    (unsafe { __exr_char_from_u32(c) }, n)
}

// --- &str / String / char の追加のメソッド (codegen が `s.name(..)` を `__exr_str_name(s, ..)` に、
//     `c.name(..)` を `__exr_char_name(c, ..)` にする。char を渡す &str の引数は UTF-8 にして渡す) ---

fn __exr_str_to_uppercase<G>(s: &str) -> String {
    let mut r = String::with_capacity(s.len());
    let mut i = 0;
    while i < s.len() {
        let (c, n) = __exr_decode_at::<()>(s.as_ptr(), i);
        r.push(__exr_char_upper1::<()>(c));
        i += n;
    }
    r
}

fn __exr_str_to_lowercase<G>(s: &str) -> String {
    let mut r = String::with_capacity(s.len());
    let mut i = 0;
    while i < s.len() {
        let (c, n) = __exr_decode_at::<()>(s.as_ptr(), i);
        r.push(__exr_char_lower1::<()>(c));
        i += n;
    }
    r
}

fn __exr_str_to_ascii_uppercase<G>(s: &str) -> String {
    let mut r = String::with_capacity(s.len());
    let mut i = 0;
    while i < s.len() {
        let (c, n) = __exr_decode_at::<()>(s.as_ptr(), i);
        r.push(c.to_ascii_uppercase());
        i += n;
    }
    r
}

fn __exr_str_to_ascii_lowercase<G>(s: &str) -> String {
    let mut r = String::with_capacity(s.len());
    let mut i = 0;
    while i < s.len() {
        let (c, n) = __exr_decode_at::<()>(s.as_ptr(), i);
        r.push(c.to_ascii_lowercase());
        i += n;
    }
    r
}

fn __exr_str_eq_ignore_ascii_case<G>(s: &str, t: &str) -> bool {
    let a = s.as_bytes();
    let b = t.as_bytes();
    if a.len() != b.len() {
        return false;
    }
    let mut i = 0;
    while i < a.len() {
        if a[i].to_ascii_lowercase() != b[i].to_ascii_lowercase() {
            return false;
        }
        i += 1;
    }
    true
}

fn __exr_str_replace<G>(s: &str, from: &str, to: &str) -> String {
    __exr_str_replacen::<()>(s, from, to, !0usize)
}

fn __exr_str_replacen<G>(s: &str, from: &str, to: &str, n: usize) -> String {
    let mut r = String::with_capacity(s.len());
    let b = s.as_bytes();
    let f = from.as_bytes();
    let mut i = 0;
    let mut last = 0;
    let mut done = 0;
    if f.len() == 0 {
        // 空の pattern は文字の間ごとに入れる (std と同じ)
        let mut k = 0;
        let mut q = 0;
        while q < s.len() {
            let (c, m) = __exr_decode_at::<()>(s.as_ptr(), q);
            if k < n {
                r.push_str(to);
                k += 1;
            }
            r.push(c);
            q += m;
        }
        if k < n {
            r.push_str(to);
        }
        return r;
    }
    while i + f.len() <= b.len() && done < n {
        let mut j = 0;
        while j < f.len() && b[i + j] == f[j] {
            j += 1;
        }
        if j == f.len() {
            r.push_str(__exr_sub::<()>(unsafe { s.as_ptr().add(last) }, i - last));
            r.push_str(to);
            i += f.len();
            last = i;
            done += 1;
        } else {
            i += 1;
        }
    }
    r.push_str(__exr_sub::<()>(unsafe { s.as_ptr().add(last) }, b.len() - last));
    r
}

fn __exr_str_repeat<G>(s: &str, n: usize) -> String {
    let mut r = String::with_capacity(s.len() * n);
    let mut i = 0;
    while i < n {
        r.push_str(s);
        i += 1;
    }
    r
}

fn __exr_str_trim_start<G>(s: &str) -> &str {
    let b = s.as_bytes();
    let mut a = 0;
    while a < b.len() && __exr_is_space::<()>(b[a]) {
        a += 1;
    }
    __exr_sub::<()>(unsafe { s.as_ptr().add(a) }, b.len() - a)
}

fn __exr_str_trim_end<G>(s: &str) -> &str {
    let b = s.as_bytes();
    let mut e = b.len();
    while e > 0 && __exr_is_space::<()>(b[e - 1]) {
        e -= 1;
    }
    __exr_sub::<()>(s.as_ptr(), e)
}

// trim_matches 系: パターンが &str (char は codegen が &str にする) か、クロージャ (`_fn`)
fn __exr_str_trim_start_matches<G>(s: &str, p: &str) -> &str {
    let mut r = s;
    if p.len() == 0 {
        return r;
    }
    while __exr_str_starts_with::<()>(r, p) {
        r = __exr_sub::<()>(unsafe { r.as_ptr().add(p.len()) }, r.len() - p.len());
    }
    r
}

fn __exr_str_trim_end_matches<G>(s: &str, p: &str) -> &str {
    let mut r = s;
    if p.len() == 0 {
        return r;
    }
    while __exr_str_ends_with::<()>(r, p) {
        r = __exr_sub::<()>(r.as_ptr(), r.len() - p.len());
    }
    r
}

fn __exr_str_trim_matches<G>(s: &str, p: &str) -> &str {
    __exr_str_trim_end_matches::<()>(__exr_str_trim_start_matches::<()>(s, p), p)
}

fn __exr_utf8_len(c: char) -> usize {
    let u = c as u32;
    if u < 0x80 {
        1
    } else if u < 0x800 {
        2
    } else if u < 0x10000 {
        3
    } else {
        4
    }
}

fn __exr_str_trim_start_matches_fn<F: FnMut(char) -> bool>(s: &str, f: F) -> &str {
    let mut f = f;
    let mut a = 0;
    for c in s.chars() {
        if !f(c) {
            break;
        }
        a += __exr_utf8_len(c);
    }
    __exr_sub::<()>(unsafe { s.as_ptr().add(a) }, s.len() - a)
}

fn __exr_str_trim_end_matches_fn<F: FnMut(char) -> bool>(s: &str, f: F) -> &str {
    let mut f = f;
    let b = s.as_bytes();
    let mut e = b.len();
    while e > 0 {
        // 最後の文字の先頭へ戻る
        let mut k = e - 1;
        while k > 0 && (b[k] & 0xC0) == 0x80 {
            k -= 1;
        }
        let c = match __exr_sub::<()>(unsafe { s.as_ptr().add(k) }, e - k).chars().next() {
            Some(c) => c,
            None => break,
        };
        if !f(c) {
            break;
        }
        e = k;
    }
    __exr_sub::<()>(s.as_ptr(), e)
}

fn __exr_str_trim_matches_fn<F: FnMut(char) -> bool>(s: &str, f: F) -> &str {
    let mut f = f;
    let t = __exr_str_trim_start_matches_fn(s, |c| f(c));
    __exr_str_trim_end_matches_fn(t, |c| f(c))
}

fn __exr_str_starts_with_fn<F: FnMut(char) -> bool>(s: &str, f: F) -> bool {
    let mut f = f;
    if s.is_empty() {
        return false;
    }
    let (c, _) = __exr_decode_at::<()>(s.as_ptr(), 0);
    f(c)
}

fn __exr_str_ends_with_fn<F: FnMut(char) -> bool>(s: &str, f: F) -> bool {
    let mut f = f;
    let b = s.as_bytes();
    if b.is_empty() {
        return false;
    }
    // 継続バイト (10xxxxxx) を戻って最後の文字の先頭へ
    let mut i = b.len() - 1;
    while i > 0 && (b[i] & 0xC0) == 0x80 {
        i -= 1;
    }
    let (c, _) = __exr_decode_at::<()>(s.as_ptr(), i);
    f(c)
}

fn __exr_str_find_fn<F: FnMut(char) -> bool>(s: &str, f: F) -> Option<usize> {
    let mut f = f;
    let mut a = 0;
    for c in s.chars() {
        if f(c) {
            return Some(a);
        }
        a += __exr_utf8_len(c);
    }
    None
}

fn __exr_str_split_at<G>(s: &str, mid: usize) -> (&str, &str) {
    if mid > s.len() || !__exr_str_is_char_boundary::<()>(s, mid) {
        panic!("byte index is not a char boundary");
    }
    (__exr_sub::<()>(s.as_ptr(), mid), __exr_sub::<()>(unsafe { s.as_ptr().add(mid) }, s.len() - mid))
}

fn __exr_str_strip_prefix<G>(s: &str, p: &str) -> Option<&str> {
    if __exr_str_starts_with::<()>(s, p) {
        Some(__exr_sub::<()>(unsafe { s.as_ptr().add(p.len()) }, s.len() - p.len()))
    } else {
        None
    }
}

fn __exr_str_strip_suffix<G>(s: &str, p: &str) -> Option<&str> {
    if __exr_str_ends_with::<()>(s, p) {
        Some(__exr_sub::<()>(s.as_ptr(), s.len() - p.len()))
    } else {
        None
    }
}

fn __exr_str_split_once<G>(s: &str, p: &str) -> Option<(&str, &str)> {
    match __exr_str_find::<()>(s, p) {
        Some(i) => Some((
            __exr_sub::<()>(s.as_ptr(), i),
            __exr_sub::<()>(unsafe { s.as_ptr().add(i + p.len()) }, s.len() - i - p.len()),
        )),
        None => None,
    }
}

fn __exr_str_rfind<G>(s: &str, t: &str) -> Option<usize> {
    let a = s.as_bytes();
    let b = t.as_bytes();
    if b.len() > a.len() {
        return None;
    }
    let mut i = a.len() - b.len() + 1;
    while i > 0 {
        i -= 1;
        let mut j = 0;
        while j < b.len() && a[i + j] == b[j] {
            j += 1;
        }
        if j == b.len() {
            return Some(i);
        }
    }
    None
}

fn __exr_str_matches_count<G>(s: &str, t: &str) -> usize {
    let a = s.as_bytes();
    let b = t.as_bytes();
    let mut n = 0;
    let mut i = 0;
    while b.len() > 0 && i + b.len() <= a.len() {
        let mut j = 0;
        while j < b.len() && a[i + j] == b[j] {
            j += 1;
        }
        if j == b.len() {
            n += 1;
            i += b.len();
        } else {
            i += 1;
        }
    }
    n
}

fn __exr_str_is_char_boundary<G>(s: &str, i: usize) -> bool {
    if i == 0 || i == s.len() {
        return true;
    }
    if i > s.len() {
        return false;
    }
    let b = s.as_bytes()[i];
    b < 0x80 || b >= 0xC0
}

// `s.split("ab")` (区切りが &str)
pub struct SplitStr {
    p: *const u8,
    len: usize,
    i: usize,
    sep: *const u8,
    slen: usize,
    done: bool,
}

impl Iterator for SplitStr {
    type Item = &str;
    fn next(&mut self) -> Option<&str> {
        if self.done {
            return None;
        }
        let st = self.i;
        let mut k = self.i;
        while k + self.slen <= self.len {
            let mut j = 0;
            while j < self.slen && unsafe { *self.p.add(k + j) == *self.sep.add(j) } {
                j += 1;
            }
            if j == self.slen && self.slen > 0 {
                self.i = k + self.slen;
                return Some(__exr_sub::<()>(unsafe { self.p.add(st) }, k - st));
            }
            k += 1;
        }
        self.done = true;
        Some(__exr_sub::<()>(unsafe { self.p.add(st) }, self.len - st))
    }
}

// `s.match_indices("ab")`: 重ならない一致の (位置, 一致した部分)
pub struct MatchIndices {
    p: *const u8,
    len: usize,
    i: usize,
    sep: *const u8,
    slen: usize,
}

impl Iterator for MatchIndices {
    type Item = (usize, &str);
    fn next(&mut self) -> Option<(usize, &str)> {
        if self.slen == 0 {
            return None;
        }
        let mut k = self.i;
        while k + self.slen <= self.len {
            let mut j = 0;
            while j < self.slen && unsafe { *self.p.add(k + j) == *self.sep.add(j) } {
                j += 1;
            }
            if j == self.slen {
                self.i = k + self.slen;
                return Some((k, __exr_sub::<()>(unsafe { self.p.add(k) }, self.slen)));
            }
            k += 1;
        }
        self.i = self.len;
        None
    }
}

fn __exr_str_match_indices<G>(s: &str, t: &str) -> MatchIndices {
    MatchIndices { p: s.as_ptr(), len: s.len(), i: 0, sep: t.as_ptr(), slen: t.len() }
}

// `s.rsplit("::")`: 後ろから区切る
pub struct RSplitStr {
    p: *const u8,
    end: usize,
    sep: *const u8,
    slen: usize,
    done: bool,
}

impl Iterator for RSplitStr {
    type Item = &str;
    fn next(&mut self) -> Option<&str> {
        if self.done {
            return None;
        }
        let e = self.end;
        if self.slen > 0 && self.slen <= e {
            let mut k = e - self.slen + 1;
            while k > 0 {
                k -= 1;
                let mut j = 0;
                while j < self.slen && unsafe { *self.p.add(k + j) == *self.sep.add(j) } {
                    j += 1;
                }
                if j == self.slen {
                    self.end = k;
                    return Some(__exr_sub::<()>(unsafe { self.p.add(k + self.slen) }, e - k - self.slen));
                }
            }
        }
        self.done = true;
        Some(__exr_sub::<()>(self.p, e))
    }
}

fn __exr_str_rsplit<G>(s: &str, t: &str) -> RSplitStr {
    RSplitStr { p: s.as_ptr(), end: s.len(), sep: t.as_ptr(), slen: t.len(), done: false }
}

fn __exr_str_rsplit_once<G>(s: &str, p: &str) -> Option<(&str, &str)> {
    match __exr_str_rfind::<()>(s, p) {
        Some(i) => Some((
            __exr_sub::<()>(s.as_ptr(), i),
            __exr_sub::<()>(unsafe { s.as_ptr().add(i + p.len()) }, s.len() - i - p.len()),
        )),
        None => None,
    }
}

fn __exr_str_split_str<G>(s: &str, t: &str) -> SplitStr {
    SplitStr { p: s.as_ptr(), len: s.len(), i: 0, sep: t.as_ptr(), slen: t.len(), done: false }
}

// `s.char_indices()` / `s.bytes()`
pub struct CharIndices {
    ptr: *const u8,
    len: usize,
    i: usize,
}

impl Iterator for CharIndices {
    type Item = (usize, char);
    fn next(&mut self) -> Option<(usize, char)> {
        if self.i >= self.len {
            return None;
        }
        let at = self.i;
        let (c, n) = __exr_decode_at::<()>(self.ptr, self.i);
        self.i += n;
        Some((at, c))
    }
}

impl CharIndices {
    // 後ろから: 継続バイト (10xxxxxx) を戻って文字の先頭を探す (len が後ろの端)
    pub fn next_back(&mut self) -> Option<(usize, char)> {
        if self.len <= self.i {
            return None;
        }
        let mut k = self.len - 1;
        while k > self.i && (unsafe { *self.ptr.add(k) } & 0xC0) == 0x80 {
            k -= 1;
        }
        let (c, _) = __exr_decode_at::<()>(self.ptr, k);
        self.len = k;
        Some((k, c))
    }
}

impl Bytes {
    pub fn next_back(&mut self) -> Option<u8> {
        if self.len <= self.i {
            return None;
        }
        self.len -= 1;
        Some(unsafe { *self.ptr.add(self.len) })
    }
}

fn __exr_str_char_indices<G>(s: &str) -> CharIndices {
    CharIndices { ptr: s.as_ptr(), len: s.len(), i: 0 }
}

pub struct Bytes {
    ptr: *const u8,
    len: usize,
    i: usize,
}

impl Iterator for Bytes {
    type Item = u8;
    fn next(&mut self) -> Option<u8> {
        if self.i >= self.len {
            return None;
        }
        self.i += 1;
        Some(unsafe { *self.ptr.add(self.i - 1) })
    }
}

fn __exr_str_bytes<G>(s: &str) -> Bytes {
    Bytes { ptr: s.as_ptr(), len: s.len(), i: 0 }
}

// `s.parse::<i32>()` など (整数だけ)
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum IntErrorKind {
    Empty,
    InvalidDigit,
    PosOverflow,
    NegOverflow,
    Zero,
}

#[derive(Debug, Clone, PartialEq, Eq)]
pub struct ParseIntError {
    kind: IntErrorKind,
}

impl ParseIntError {
    pub fn kind(&self) -> &IntErrorKind {
        &self.kind
    }
}

impl Display for ParseIntError {
    fn fmt(&self, f: &mut Formatter) -> Result<(), __FmtError> {
        f.pad(match self.kind {
            IntErrorKind::Empty => "cannot parse integer from empty string",
            IntErrorKind::InvalidDigit => "invalid digit found in string",
            IntErrorKind::PosOverflow => "number too large to fit in target type",
            IntErrorKind::NegOverflow => "number too small to fit in target type",
            IntErrorKind::Zero => "number would be zero for non-zero type",
        })
    }
}

pub trait __FromStr {
    type Err;
    fn __from_str(s: &str) -> Result<Self, Self::Err>;
}

// 符号と絶対値 (u64) に読む。max は正の上限、neg_max は負の絶対値の上限
fn __exr_parse_int<G>(s: &str, signed: bool, max: u64, neg_max: u64) -> Result<(bool, u64), ParseIntError> {
    let b = s.as_bytes();
    if b.len() == 0 {
        return Err(ParseIntError { kind: IntErrorKind::Empty });
    }
    let mut i = 0;
    let mut neg = false;
    if b[0] == b'+' || (b[0] == b'-' && signed) {
        neg = b[0] == b'-';
        i = 1;
        if b.len() == 1 {
            return Err(ParseIntError { kind: IntErrorKind::InvalidDigit });
        }
    }
    let lim = if neg { neg_max } else { max };
    let mut v: u64 = 0;
    while i < b.len() {
        let c = b[i];
        if c < b'0' || c > b'9' {
            return Err(ParseIntError { kind: IntErrorKind::InvalidDigit });
        }
        let d = (c - b'0') as u64;
        if v > (lim - d) / 10 {
            // 残りに数字以外があれば InvalidDigit が先 (std と同じく前から読む)
            let mut k = i + 1;
            while k < b.len() {
                if b[k] < b'0' || b[k] > b'9' {
                    return Err(ParseIntError { kind: IntErrorKind::InvalidDigit });
                }
                k += 1;
            }
            return Err(ParseIntError {
                kind: if neg { IntErrorKind::NegOverflow } else { IntErrorKind::PosOverflow },
            });
        }
        v = v * 10 + d;
        i += 1;
    }
    Ok((neg, v))
}

impl __FromStr for i8 {
    type Err = ParseIntError;
    fn __from_str(s: &str) -> Result<i8, ParseIntError> {
        match __exr_parse_int::<()>(s, true, 127, 128) {
            Ok((n, v)) => Ok(if n { (v as i8).wrapping_neg() } else { v as i8 }),
            Err(e) => Err(e),
        }
    }
}
impl __FromStr for i16 {
    type Err = ParseIntError;
    fn __from_str(s: &str) -> Result<i16, ParseIntError> {
        match __exr_parse_int::<()>(s, true, 32767, 32768) {
            Ok((n, v)) => Ok(if n { (v as i16).wrapping_neg() } else { v as i16 }),
            Err(e) => Err(e),
        }
    }
}
impl __FromStr for i32 {
    type Err = ParseIntError;
    fn __from_str(s: &str) -> Result<i32, ParseIntError> {
        match __exr_parse_int::<()>(s, true, 2147483647, 2147483648) {
            Ok((n, v)) => Ok(if n { (v as i32).wrapping_neg() } else { v as i32 }),
            Err(e) => Err(e),
        }
    }
}
impl __FromStr for i64 {
    type Err = ParseIntError;
    fn __from_str(s: &str) -> Result<i64, ParseIntError> {
        match __exr_parse_int::<()>(s, true, 9223372036854775807, 9223372036854775808) {
            Ok((n, v)) => Ok(if n { (v as i64).wrapping_neg() } else { v as i64 }),
            Err(e) => Err(e),
        }
    }
}
