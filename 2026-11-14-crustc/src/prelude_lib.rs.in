// powi: compiler-rt の __powidf2 と同じく 2 乗を繰り返す
fn __exr_powi<G>(a: f64, n: i32) -> f64 {
    let neg = n < 0;
    let mut m = if neg { -(n as i64) } else { n as i64 };
    let mut a = a;
    let mut r = 1.0;
    loop {
        if m & 1 != 0 {
            r = r * a;
        }
        m /= 2;
        if m == 0 {
            break;
        }
        a = a * a;
    }
    if neg { 1.0 / r } else { r }
}

fn __exr_powif<G>(a: f32, n: i32) -> f32 {
    let neg = n < 0;
    let mut m = if neg { -(n as i64) } else { n as i64 };
    let mut a = a;
    let mut r: f32 = 1.0;
    loop {
        if m & 1 != 0 {
            r = r * a;
        }
        m /= 2;
        if m == 0 {
            break;
        }
        a = a * a;
    }
    if neg { 1.0 / r } else { r }
}

fn __exr_fmt_bool<G>(f: &mut Formatter, b: bool) {
    __exr_fmt_str::<()>(f, if b { "true" } else { "false" });
}

fn __exr_fmt_char<G>(f: &mut Formatter, c: char) {
    let mut s = String::new();
    s.push(c);
    __exr_fmt_str::<()>(f, s.as_str());
}

fn __exr_escape<G>(s: &mut String, c: char, quote: char) {
    if c == quote || c == '\\' {
        s.push('\\');
        s.push(c);
    } else if c == '\n' {
        s.push_str("\\n");
    } else if c == '\r' {
        s.push_str("\\r");
    } else if c == '\t' {
        s.push_str("\\t");
    } else if c == '\0' {
        s.push_str("\\0");
    } else {
        s.push(c);
    }
}

fn __exr_fmt_str_debug<G>(f: &mut Formatter, x: &str) {
    let mut s = String::new();
    s.push('"');
    for &b in x.as_bytes() {
        if b < 0x80 {
            __exr_escape::<()>(&mut s, b as char, '"');
        } else {
            s.vec.push(b);
        }
    }
    s.push('"');
    __exr_pad::<()>(f, s.as_str(), 1);
}

fn __exr_fmt_char_debug<G>(f: &mut Formatter, c: char) {
    let mut s = String::new();
    s.push('\'');
    __exr_escape::<()>(&mut s, c, '\'');
    s.push('\'');
    __exr_pad::<()>(f, s.as_str(), 1);
}

fn __exr_indent<G>(f: &mut Formatter) {
    let mut i = 0;
    while i < f.indent {
        f.buf.push_str("    ");
        i += 1;
    }
}

// Debug の整形: kind 0 = `Name { a: .. }`, 1 = `Name(..)` / タプル, 2 = `[..]`, 3 = `{k: v}`
fn __exr_dbg_begin<G>(f: &mut Formatter, name: &str, kind: u8) {
    f.buf.push_str(name);
    let open = if kind == 0 {
        if f.alt { " {" } else { " { " }
    } else if kind == 1 {
        "("
    } else if kind == 2 {
        "["
    } else {
        "{"
    };
    f.buf.push_str(open);
    if f.alt {
        f.buf.push('\n');
        f.indent += 1;
    }
}

fn __exr_dbg_item<G>(f: &mut Formatter, i: usize, key: &str) {
    if f.alt {
        __exr_indent::<()>(f);
    } else if i > 0 {
        f.buf.push_str(", ");
    }
    if !key.is_empty() {
        f.buf.push_str(key);
        f.buf.push_str(": ");
    }
}

fn __exr_dbg_item_end<G>(f: &mut Formatter) {
    if f.alt {
        f.buf.push_str(",\n");
    }
}

fn __exr_dbg_end<G>(f: &mut Formatter, n: usize, kind: u8, tuple: bool) {
    let close = if kind == 0 {
        if f.alt { "}" } else { " }" }
    } else if kind == 1 {
        ")"
    } else if kind == 2 {
        "]"
    } else {
        "}"
    };
    if f.alt {
        f.indent -= 1;
        __exr_indent::<()>(f);
    } else if tuple && n == 1 {
        // `(1,)`
        f.buf.push(',');
    }
    f.buf.push_str(close);
}

// 書式指定の状態を保存して、入れ子の値を既定の書式で書く (`{:>5?}` の中の要素など)
fn __exr_dbg_value_begin(f: &mut Formatter) -> usize {
    let w = f.width;
    f.width = 0;
    w
}

fn __exr_print<G>(s: &String) {
    for &b in s.as_bytes() {
        unsafe {
            __exr_putchar(b as i32);
        }
    }
}

