// アプリと shell の境界 (PROTOCOL.md の P1 / P2 を型付きにしたもの)。
// アプリが import できるのは host だけ: できるのは「意味ツリーを出す」ことだけで、画面にもファイルにもネットにも触れない。
package gui:app@0.1.0;

interface types {
  enum role {
    x-window, heading, paragraph, group, %list, listitem, checkbox, switch, textbox, button,
    radio, combobox, slider, spinbutton, progressbar, tablist, tab, table, row, cell, columnheader, separator, img,
  }
  enum action-name { click, focus, set-value, replace-selected-text, increment, decrement }
  enum actor { human, agent }

  record node {
    id: string,
    role: role,
    label: option<string>,
    value: option<string>,
    checked: option<bool>,
    disabled: bool,
    sensitive: bool,
    actions: list<action-name>,
    children: list<string>,
  }

  /// P1: app -> shell
  record tree-update {
    root: option<string>,
    focus: option<string>,
    nodes: list<node>,
    remove: list<string>,
  }

  /// P2: shell -> app
  record action-request {
    target: string,
    action: action-name,
    data: option<string>,
    by: actor,
  }
}

/// shell が提供する
interface host {
  use types.{tree-update};
  emit: func(update: tree-update);
}

/// アプリが提供する
interface app {
  use types.{action-request};
  start: func();
  on-action: func(req: action-request);
}

/// 能力 storage: アプリ自身の保存領域 (同じアプリの窓で共有)。manifest で storage を宣言したアプリにだけ、ホストがこの import を渡す
interface storage {
  get: func(key: string) -> option<string>;
  /// 保存できたら true (人が保存を拒否していれば false)
  set: func(key: string, value: string) -> bool;
}

world gui-app {
  import host;
  export app;
}

/// 保存領域を使うアプリ。import が能力そのもの: storage を宣言していないアプリには、この import を渡さない (リンクできない)
world gui-app-storage {
  import host;
  import storage;
  export app;
}
