{
  "name": "ai-native-desktop-proto-canvas",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "esbuild src/main.ts --bundle --format=esm --splitting --chunk-names=chunks/[name]-[hash] --sourcemap --outdir=www --servedir=www --serve=127.0.0.1:8123",
    "build": "esbuild src/main.ts --bundle --format=esm --splitting --chunk-names=chunks/[name]-[hash] --sourcemap --outdir=www",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "e2e": "node e2e/smoke.cjs",
    "veriss-diff": "node e2e/veriss-diff.cjs",
    "veriss-repro": "node e2e/veriss-repro.mjs",
    "e2e:dnd": "node e2e/dnd.cjs",
    "sway-bridge": "node e2e/sway-bridge.ts",
    "font-diff": "node e2e/font-diff.ts",
    "perf": "node e2e/perf.ts",
    "e2e:a11y": "node e2e/a11y.cjs",
    "atspi-bridge": "legacy/run-env.sh node e2e/atspi-bridge.ts",
    "mcp": "node mcp/server.ts",
    "e2e:mcp": "node e2e/mcp.ts",
    "build:component": "cd component/todo-rs && cargo build --release --target wasm32-wasip2 && cp target/wasm32-wasip2/release/todo_rs.wasm ../todo.wasm",
    "gen:component": "jco transpile component/todo.wasm -o component/gen --name todo --instantiation sync --quiet",
    "pretest": "pnpm -s gen:component",
    "fonts": "mkdir -p www/fonts && cp /usr/share/fonts/opentype/ipaexfont-gothic/ipaexg.ttf www/fonts/",
    "build:odin": "odin build backend-odin -target:js_wasm32 -o:speed -out:www/raster.wasm && cp \"$(odin root)/core/sys/wasm/js/odin.js\" www/odin.js"
  },
  "devDependencies": {
    "@bytecodealliance/jco": "^1.42.0",
    "@bytecodealliance/preview2-shim": "^0.31.1",
    "@mizchi/veriss": "github:mizchi/veriss#ee4cb5a559856f475e379335e3200b353c465242&path:packages/veriss",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.2",
    "axe-core": "^4.14.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "ws": "^8.23.0",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=24"
  }
}
